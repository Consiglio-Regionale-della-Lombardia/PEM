<?xml version="1.0" encoding="utf-8"?>
<!--
  Template dei parametri sensibili e specifici per ambiente dell'API
  pubblica. Copiare questo file accanto al Web.config rinominandolo in
  Secrets.config e compilare i valori reali. Il file Secrets.config e'
  escluso dal versionamento tramite .gitignore.

  Le chiavi qui presenti si combinano con quelle dichiarate nel
  <appSettings> del Web.config grazie all'attributo file=: se una chiave
  e' presente sia nel Web.config sia nel Secrets.config locale, vince il
  Secrets.config locale. Per questo motivo il template include sia il
  vero segreto (masterKey) sia gli override "ambiente-specifici" che
  tipicamente cambiano fra dev, test e produzione (path su disco e
  base URL del frontend GeDASI). Lasciandoli a stringa vuota si usano
  i valori di default presenti nel Web.config.
-->
<appSettings>
  <!-- Chiave di crittografia condivisa con l'API principale. Valore
       reale obbligatorio: senza, gli atti certificati non si decifrano. -->
  <add key="masterKey" value="" />

  <!-- Cartella su disco in cui l'API pubblica legge gli allegati storici
       degli atti (residuo della compatibilita' con PEM 1.x). Esempi:
       C:\DocumentiPEM in sviluppo, D:\DocumentiPEM in produzione. -->
  <add key="PercorsoCompatibilitaDocumenti" value="" />
  
  <add key="PrefissoCompatibilitaDocumenti" value="" />

  <!-- Base URL della pagina pubblica per la versione originale dell'atto.
       Il placeholder {{QRCODE}} viene rimpiazzato a runtime con
       l'identificativo del QR code dell'atto. -->
  <add key="urlDASI_Originale" value="" />

  <!-- Base URL della pagina pubblica per la trattazione dell'atto. Stesso
       schema di urlDASI_Originale. -->
  <add key="urlDASI_Trattazione" value="" />
</appSettings>
