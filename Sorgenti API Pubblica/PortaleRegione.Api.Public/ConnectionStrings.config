<?xml version="1.0" encoding="utf-8"?>
<!--
  Stringa di connessione locale al database GEDASI per l'API pubblica.
  Vedi note in Sorgenti API/.../PortaleRegione.API/ConnectionStrings.config.
-->
<connectionStrings>
  <add name="PortaleRegioneDbContext"
       connectionString="data source=(localdb)\MSSQLLocalDB;initial catalog=dbEmendamenti;integrated security=true;MultipleActiveResultSets=True;App=EntityFramework"
       providerName="System.Data.SqlClient" />
</connectionStrings>
