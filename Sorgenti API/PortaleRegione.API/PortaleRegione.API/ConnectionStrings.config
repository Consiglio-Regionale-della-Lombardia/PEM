<?xml version="1.0" encoding="utf-8"?>
<!--
  Stringa di connessione locale al database GEDASI.
  Per sviluppo è impostata su LocalDB; in ambiente reale sostituire i parametri
  con quelli del proprio SQL Server e marcare il file come skip-worktree:
    git update-index --skip-worktree "Sorgenti API/PortaleRegione.API/PortaleRegione.API/ConnectionStrings.config"
-->
<connectionStrings>
  <add name="PortaleRegioneDbContext"
       connectionString="data source=(localdb)\MSSQLLocalDB;initial catalog=dbEmendamenti;integrated security=true;MultipleActiveResultSets=True;App=EntityFramework"
       providerName="System.Data.SqlClient" />
</connectionStrings>
