<?xml version="1.0" encoding="utf-8"?>
<!--
  Template dei parametri sensibili dell'API. Copiare questo file accanto al Web.config
  rinominandolo in Secrets.config e compilare i valori reali. Il file Secrets.config
  è escluso dal versionamento tramite .gitignore.
-->
<appSettings>
  <add key="JWT_MASTER" value="" />
  <add key="TOKEN_R" value="" />
  <add key="TOKEN_W" value="" />
  <add key="MasterPIN" value="" />
  <add key="masterKey" value="" />
  <add key="PDF_LICENSE" value="" />
  <add key="OpenData_PrivateToken" value="" />
  <add key="Service_Username" value="" />
  <add key="Service_Password" value="" />
  <add key="GEA_Username" value="" />
  <add key="GEA_Password" value="" />
  <add key="SMTP" value="" />
  <add key="EmailFrom" value="" />
  <add key="EmailInvioDASI" value="" />
  <add key="EmailProtocolloDASI" value="" />
</appSettings>
