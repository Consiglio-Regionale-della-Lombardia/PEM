<!-- Modal Structure -->
<div id="modalIscriviSeduta" class="modal bottom-sheet">
    <div class="modal-content">
        <input type="hidden" id="hfUidAtto">
        <h4 id="txtIscriviSeduta"></h4>
        <ul class="collection with-header" id="lstSeduteAttive">
        </ul>
        @* #1627 - Iscrizione ex post su una seduta gia' chiusa (ultime 20 sedute chiuse) *@
        <div id="sezioneSeduteChiuse">
            <button type="button" role="button" class="btn-flat blue-text" id="btnAltraSedutaDASI">
                <i class="material-icons left">event_busy</i>Altra seduta
            </button>
            <div id="containerSeduteChiuse" class="input-field" style="display:none;">
                <select id="ddlSeduteChiuse">
                    <option value="" disabled selected>Seleziona una seduta chiusa</option>
                </select>
                <label for="ddlSeduteChiuse">Iscrivi a una seduta gi&agrave; chiusa</label>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <a href="#!" class="modal-close waves-effect waves-green btn-flat" id="btnIscriviSeduta_Salva">Iscrivi</a>
    </div>
</div>

<script>
    var sedute = [];
    // #1627 - cache delle ultime sedute chiuse (caricate al primo click su "Altra seduta")
    var seduteChiuse = [];
    $(window).on('load',
        async function() {
            if (sedute.length == 0) {
                $('#modalIscriviSeduta>div>ul').empty();
                var data = await GetSeduteAttive();
                sedute = data.Results;
                var checked = sedute.length == 1;
				console.log("SEDUTE ATTIVE", sedute)
                $.each(sedute,
                    function(i, item) {
                        var resultDate = GetFormattedDate(item.Data_seduta);
                        var text = "Seduta del " + resultDate;
                        $('#modalIscriviSeduta>div>ul').append(templateSeduteAttive
                            .replace("{TEXT}", text)
                            .replace("{VALUE}", item.UIDSeduta)
                            .replace("{CHECKED}", checked ? "checked='checked'" : ""));
                    });
            }

            // #1627 - "Altra seduta": carica e mostra le ultime 20 sedute chiuse
            $('#btnAltraSedutaDASI').off('click').on('click',
                async function() {
                    var ddl = document.getElementById('ddlSeduteChiuse');
                    if (seduteChiuse.length == 0) {
                        var dataChiuse = await GetSeduteChiuse();
                        seduteChiuse = (dataChiuse && dataChiuse.Results) ? dataChiuse.Results : [];
                        // svuoto le opzioni tranne il placeholder
                        $('#ddlSeduteChiuse option:not(:first)').remove();
                        $.each(seduteChiuse,
                            function(i, item) {
                                var text = "Seduta del " + GetFormattedDate(item.Data_seduta);
                                $('#ddlSeduteChiuse').append("<option value='" + item.UIDSeduta + "'>" + text + "</option>");
                            });
                        var instance = M.FormSelect.getInstance(ddl);
                        if (instance) instance.destroy();
                        M.FormSelect.init(ddl);
                    }
                    $('#containerSeduteChiuse').show();
                });

            // #1627 - selezione di una seduta chiusa: diventa l'opzione di iscrizione attiva
            $('#ddlSeduteChiuse').off('change').on('change',
                function() {
                    var uidSeduta = this.value;
                    if (!uidSeduta) return;
                    var text = this.options[this.selectedIndex].text;
                    // sostituisco l'eventuale seduta chiusa selezionata in precedenza
                    $('#lstSeduteAttive li.seduta-chiusa-item').remove();
                    $('#lstSeduteAttive').append(
                        "<li class='collection-item seduta-chiusa-item'><div><p><label>"
                        + "<input name='gruppoSeduteAttive' type='radio' value='" + uidSeduta + "' checked='checked'/>"
                        + "<span>" + text + " <b>(chiusa)</b></span></label></p></div></li>");
                });
        });

    // #1627 - reset della sezione "Altra seduta" ad ogni apertura della maschera
    function ResetSeduteChiuse() {
        $('#containerSeduteChiuse').hide();
        $('#lstSeduteAttive li.seduta-chiusa-item').remove();
        var ddl = document.getElementById('ddlSeduteChiuse');
        if (ddl) {
            ddl.selectedIndex = 0;
            var instance = M.FormSelect.getInstance(ddl);
            if (instance) {
                instance.destroy();
                M.FormSelect.init(ddl);
            }
        }
    }

    function RimuoviSedutaDASI(uidAtto, nomeAtto) {

        swal({
            title: "Rimozione atto dalla seduta",
            text: "Sei sicuro di voler rimuovere " + nomeAtto + " dalla seduta associata?",
            icon: "warning",
            buttons: ["Annulla", "Rimuovi"],
            dangerMode: true
        }).then((willDelete) => {
            if (willDelete) {
                var listaAtti = [];

                listaAtti.push(uidAtto);

                var obj = {};
                obj.Lista = listaAtti;

                $.ajax({
                    url: '@Url.Action("RimuoviSeduta")',
                    method: "POST",
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json"
                }).done(function(data) {
                    $("#modalRimuoviSeduta").modal("close");
                    $("#btnRimuoviSeduta_Salva").off("click");
                    console.log(data.message);
                    if (data.message) {
                        swal({
                            title: "Errore",
                            text: data.message,
                            icon: "error"
                        });
                    } else {
                        go(data);
                    }
                }).fail(function(err) {
                    console.log("error", err);
                    MostraErrore(err);
                });
            }
        });
    }

    function IscriviASedutaMassivoDASI() {
        var text = "";
        var listaAtti = [];
        const selectedCheckboxes = document.querySelectorAll('input[type="checkbox"][id^="chk_Atto_"]:checked');
        // Itera sui checkbox selezionati
        selectedCheckboxes.forEach(checkbox => {
            // Trova la riga padre del checkbox
            const row = checkbox.closest('tr');
            const displayColumn = row.querySelector('td:nth-child(2) .chip');

            if (displayColumn) {
                const displayId = displayColumn.getAttribute('data-id');
                listaAtti.push(displayId);
            }
        });
        
		var text_counter = listaAtti.length;
        text = "Iscrivi in una delle seguenti sedute:";

        $('#txtIscriviSeduta').html(text);
        ResetSeduteChiuse();
        $('#btnIscriviSeduta_Salva').text("Iscrivi");
        $('#btnIscriviSeduta_Salva').off("click");
        $("#btnIscriviSeduta_Salva").on("click",
            function() {

                if ($('input[name="gruppoSeduteAttive"]:checked').length == 0) {
                    swal({
                        title: "Errore",
                        text: "Seleziona almeno una seduta dove iscrivere l'atto " + nomeAtto,
                        icon: "error"
                    });
                    return;
                }

                var checkSelezionaTutti = $("#checkAll")[0].checked;
                var totaleRisultati = $(".pagination").data("totale-risultati");
                var uidSeduta = $('input[name="gruppoSeduteAttive"]:checked')[0].value;
                
                swal({
                    title: "Conferma iscrizione seduta",
                    text: "Scegli l'ambito di applicazione per l'iscrizione:",
                    icon: "info",
                    buttons: {
                        cancel: "Annulla",
                        tutti: checkSelezionaTutti ? {
                            text: `Tutti (${totaleRisultati} atti)`,
                            value: "tutti",
                            className: "amber"
                        }: null,
                        griglia: {
                            text: `Griglia (${text_counter} atti)`,
                            value: "griglia",
                            className: "blue"
                        }
                    }
                }).then(async (value) => {
                    if (value === "griglia") {
                        // Flusso normale - solo atti selezionati in griglia
                        
                        await IscrizioneASedutaMassivoDASISoloIds(uidSeduta, listaAtti);
                    } else if (value === "tutti") {
                        // Nuovo flusso - tutti gli atti con progress modal
                        var totalePagine = $(".pagination").data("totale-pagine");
                        await aprireModalProgresso(2, uidSeduta, totalePagine, totaleRisultati);
                    }
                });
            });
        $('#modalIscriviSeduta').modal("open");
    }

    function IscriviSedutaDASI(uidAtto, nomeAtto) {
        $('#hfUidAtto').val(uidAtto);
        ResetSeduteChiuse();
        $('#txtIscriviSeduta').html("Iscrivi <b>" + nomeAtto + "</b> ad una delle seguenti sedute");
        $('#btnIscriviSeduta_Salva').text("Iscrivi");
        $('#btnIscriviSeduta_Salva').off("click");
        $("#btnIscriviSeduta_Salva").on("click",
            function() {

                if ($('input[name="gruppoSeduteAttive"]:checked').length == 0) {
                    swal({
                        title: "Errore",
                        text: "Seleziona almeno una seduta dove iscrivere l'atto " + nomeAtto,
                        icon: "error"
                    });
                    return;
                }

                var listaAtti = [];

                listaAtti.push(uidAtto);

                var obj = {};
                obj.UidSeduta = $('input[name="gruppoSeduteAttive"]:checked')[0].value;
                obj.Lista = listaAtti;

                $.ajax({
                    url: '@Url.Action("IscriviSeduta")',
                    method: "POST",
                    data: JSON.stringify(obj),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json"
                }).done(function(data) {
                    $("#modalIscriviSeduta").modal("close");
                    $("#btnIscriviSeduta_Salva").off("click");
                    console.log(data.message);
                    if (data.message) {
                        swal({
                            title: "Errore",
                            text: data.message,
                            icon: "error"
                        });
                    } else {
                        go(data);
                    }
                }).fail(function(err) {
                    console.log("error", err);
                    MostraErrore(err);
                });
            });
        $('#modalIscriviSeduta').modal("open");
    }

</script>