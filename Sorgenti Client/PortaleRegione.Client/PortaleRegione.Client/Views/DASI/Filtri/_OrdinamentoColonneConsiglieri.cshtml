@using System.ComponentModel
@using PortaleRegione.DTO.Domain

@* Modal Ordinamento Risultati - Consiglieri *@
<div id="modalOrdinamentoRisultati" class="modal">
    <div class="modal-content">
        <h4>Seleziona le colonne della griglia da ordinare</h4>
        <div class="row">
            <div class="input-field col s12">
                <select name="sort-columns-grid" id="sort-columns-grid-select" onchange="handleSortColumnChange()">
                    <option value="" disabled selected>Seleziona</option>
                    @foreach (var prop in typeof(AttiDASISortingConsiglieri).GetProperties())
                    {
                        var displayName = prop.GetCustomAttributes(typeof(DisplayNameAttribute), true)
                            .Cast<DisplayNameAttribute>()
                            .FirstOrDefault()?.DisplayName ?? prop.Name;

                        <option value="@prop.Name">@displayName</option>
                    }
                </select>
            </div>
            <div class="col s12">
                <table class="highlight">
                    <thead>
                    <tr>
                        <th>Colonna</th>
                        <th>Ordinamento</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody id="sort-list">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="modal-close btn-flat">Annulla</button>
        <button type="button" onclick="btnResetOrdinamentoColonneGriglia()" class="btn-flat red-text">Reset</button>
        <button type="button" onclick="btnSalvaOrdinamentoColonneGriglia()" class="btn-flat blue-text">Salva</button>
    </div>
</div>

@* Modal Selezione Colonne - Consiglieri *@
<div id="modalColonneGriglia" class="modal">
    <div class="modal-content">
        <div class="row">
            <div class="col s12">
                <h4>Seleziona le colonne della griglia</h4>
                <ul id="columns-grid-list" class="collection">
                    @foreach (var prop in typeof(AttiDASIColumnsConsiglieri).GetProperties())
                    {
                        var displayName = prop.GetCustomAttributes(typeof(DisplayNameAttribute), true)
                            .Cast<DisplayNameAttribute>()
                            .FirstOrDefault()?.DisplayName ?? prop.Name;

                        <li class="collection-item">
                            <label>
                                <input type="checkbox" value="@prop.Name"/>
                                <span>@displayName</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn-flat modal-close">Annulla</button>
        <button type="button" onclick="btnResetColonneGriglia()" class="btn-flat red-text">Reset</button>
        <button type="button" onclick="btnSalvaColonneGriglia()" class="btn-flat blue-text">Salva</button>
    </div>
</div>

<script>
    $(document).on('click', '#btnSelezionaColonne', function () {
        waiting(true);
        var savedColumns = JSON.parse(localStorage.getItem('selectedColumns')) || [];
        document.querySelectorAll('#columns-grid-list input[type="checkbox"]').forEach(function(chk) {
            var isSelected = savedColumns.some(function(col) { return col.propertyName === chk.value; });
            chk.checked = isSelected;
        });
        waiting(false);
        $('#modalColonneGriglia').modal("open");
    });

    $(document).on('click', '#btnOrdinamentoRisultati', function () {
        openOrdinamentoModal();
    });

    function openOrdinamentoModal() {
        var savedColumns = JSON.parse(localStorage.getItem('selectedSortColumns')) || [];
        var sortList = document.getElementById('sort-list');
        sortList.innerHTML = '';
        savedColumns.forEach(function(item) {
            var row = document.createElement("tr");
            row.innerHTML =
                '<td>' + item.displayText + '</td>' +
                '<td><select data-column="' + item.propertyName + '" onchange="updateSortDirection(\'' + item.propertyName + '\', this.value)">' +
                '<option value="1"' + (item.sortDirection === "1" ? ' selected' : '') + '>Crescente</option>' +
                '<option value="-1"' + (item.sortDirection === "-1" ? ' selected' : '') + '>Decrescente</option>' +
                '</select></td>' +
                '<td><button type="button" onclick="removeSortColumn(\'' + item.propertyName + '\', this)" class="btn-flat red-text">Rimuovi</button></td>';
            sortList.appendChild(row);
        });
        $("select").formSelect();
        $('#modalOrdinamentoRisultati').modal("open");
    }

    function handleSortColumnChange() {
        var select = document.getElementById("sort-columns-grid-select");
        var selectedColumn = select.options[select.selectedIndex].value;
        var displayText = select.options[select.selectedIndex].text;
        if (!selectedSortColumns.includes(selectedColumn)) {
            selectedSortColumns.push(selectedColumn);
            var sortList = document.getElementById("sort-list");
            var row = document.createElement("tr");
            row.innerHTML =
                '<td>' + displayText + '</td>' +
                '<td><select data-column="' + selectedColumn + '" onchange="updateSortDirection(\'' + selectedColumn + '\', this.value)">' +
                '<option value="1">Crescente</option><option value="-1">Decrescente</option></select></td>' +
                '<td><button type="button" onclick="removeSortColumn(\'' + selectedColumn + '\', this)" class="btn-flat red-text">Rimuovi</button></td>';
            sortList.appendChild(row);
            $("select").formSelect();
        }
    }

    function updateSortDirection(column, direction) {
        selectedSortColumns = selectedSortColumns.map(function(item) {
            return item === column ? { column: column, direction: parseInt(direction) } : item;
        });
    }

    function removeSortColumn(column, element) {
        selectedSortColumns = selectedSortColumns.filter(function(item) { return item.column !== column; });
        element.closest("tr").remove();
    }

    function btnResetColonneGriglia() {
        localStorage.setItem('selectedColumns', JSON.stringify([]));
        document.querySelectorAll('#columns-grid-list input[type="checkbox"]').forEach(function(chk) { chk.checked = false; });
        inviaDatiChips(1, 20);
    }

    function btnSalvaColonneGriglia() {
        var selectedColumns = Array.from(
            document.querySelectorAll('#columns-grid-list input[type="checkbox"]:checked')
        ).map(function(chk) {
            return { propertyName: chk.value, displayText: chk.parentElement.querySelector("span").textContent };
        });
        localStorage.setItem('selectedColumns', JSON.stringify(selectedColumns));
        inviaDatiChips(1, 20);
        $('#modalColonneGriglia').modal('close');
    }

    function btnSalvaOrdinamentoColonneGriglia() {
        var selectedColumns = Array.from(document.querySelectorAll('#sort-list tr')).map(function(row) {
            return {
                propertyName: row.querySelector('select').getAttribute('data-column'),
                displayText: row.querySelector('td:first-child').innerText,
                sortDirection: row.querySelector('select').value
            };
        });
        localStorage.setItem('selectedSortColumns', JSON.stringify(selectedColumns));
        location.reload();
    }

    function btnResetOrdinamentoColonneGriglia() {
        localStorage.removeItem('selectedSortColumns');
        document.getElementById('sort-list').innerHTML = '';
        selectedSortColumns = [];
        $('#chips-container-sorting').empty();
        location.reload();
    }
</script>