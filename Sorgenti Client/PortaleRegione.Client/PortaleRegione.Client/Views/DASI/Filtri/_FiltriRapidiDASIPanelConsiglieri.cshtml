    `;

        const rowContent = document.createElement('div');
        rowContent.className = "col s12 card-content";
        rowContent.innerHTML = result.BodyAtto;

        rowCard.appendChild(btnContainer);
        rowCard.appendChild(rowContent);

        return rowCard;
