            }

            const li = document.createElement('li');
            li.className = `badgeBody ${getTipoCSSClass(result.Tipo)}`;
            li.innerHTML = `
<div class="collapsible-header valign-wrapper" tabindex="0">
    <div class="col l4 m4 s12 valign-wrapper" style="display: inline-flex">
        <p>
            <label>
                <input type="checkbox" id="chk_Atto_${result.UIDAtto}" onclick="AbilitaComandiMassivi_DASI('${result.UIDAtto}');"/>
