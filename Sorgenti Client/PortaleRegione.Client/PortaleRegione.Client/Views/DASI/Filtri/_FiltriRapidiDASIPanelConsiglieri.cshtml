    function addChipIfNotExists(key, keyLabel, val, label, chipText, refresh, visible) {

        var existingChip = document.querySelector(`.chip[data-filterby="${key}"]`);

        if (!existingChip) {
            var chipsContainer = document.getElementById('chips-container');
            var newChip = document.createElement('div');
            newChip.setAttribute('data-val', val);
            newChip.setAttribute('data-label', label);
            newChip.setAttribute('data-filterby', key);
            newChip.setAttribute('data-filterby-label', keyLabel);
            newChip.classList.add('chip');
            newChip.classList.add('filter-chip');
            newChip.textContent = chipText;

            if (visible === false) {
                newChip.style.display = "none";
            }

            addIconsToChip(newChip, key, keyLabel, val);
            chipsContainer.appendChild(newChip);

            chipsKeys[key] = true;
        } else {
            existingChip.setAttribute('data-val', val);
            existingChip.setAttribute('data-label', label);
            existingChip.setAttribute('data-filterby', key);
            existingChip.setAttribute('data-filterby-label', keyLabel);
            existingChip.textContent = chipText;

            if (visible === false) {
                existingChip.style.display = "none";
            }

            addIconsToChip(existingChip, key, keyLabel, val);
        }

        salvaFiltri();

        if (refresh) {
            console.log("refresh");
            inviaDatiChips(1, $("#hdPaginazioneCorrente").val());
        }
    }

    function addIconsToChip(chip, key, keyLabel, val) {

        // Skip icons for fixed/default chips
        if (defaultKeysConsiglieri.has(key)) {
            return;
        }

        var editIcon = document.createElement('i');
        editIcon.classList.add('material-icons', 'tiny');
        editIcon.style.setProperty('margin-left', '10px');
        editIcon.style.setProperty('top', '2px');
        editIcon.textContent = 'edit';
        editIcon.onclick = async function(event) {
            event.stopPropagation();
            await openModalWithContent(key, keyLabel, true, val);
        };
        chip.appendChild(editIcon);

        var closeIcon = document.createElement('i');
        closeIcon.classList.add('close', 'material-icons');
        closeIcon.style.setProperty('top', 'unset', 'important');
        closeIcon.textContent = 'close';
        closeIcon.onclick = function() {
            delete chipsKeys[key];
            chip.remove();
            resetSelezionePreferiti();
            salvaFiltri();
            console.log("rimuovi chip");
            inviaDatiChips(1, $("#hdPaginazioneCorrente").val());
        };
        chip.appendChild(closeIcon);
    }

    function salvaFiltri() {
        const filtri = [];
        document.querySelectorAll('#chips-container .chip.filter-chip').forEach(function(chip) {
            const key = chip.getAttribute('data-filterby');
            const keyLabel = chip.getAttribute('data-filterby-label');
            const val = chip.getAttribute('data-val');
            const label = chip.getAttribute('data-label');
            const chipTextContent = chip.cloneNode(true);
            chipTextContent.querySelectorAll('.material-icons').forEach(icon => icon.remove());
            const chipText = chipTextContent.textContent.trim();

            filtri.push({
                key: key,
                keyLabel: keyLabel,
                val: val,
                label: label,
                chipText: chipText
            });
        });
        localStorage.setItem('filtriDasi', JSON.stringify(filtri));
    }

    function ripristinaFiltri() {
        $('#chips-container').empty();

        var filtriDasi = JSON.parse(localStorage.getItem('filtriDasi')) || [];
        var gruppoVal = '@Html.Raw(Model.CurrentUser?.Gruppo != null ? Model.CurrentUser.Gruppo.id_gruppo.ToString() : "")';

        // Chip Gruppo: SEMPRE presente e invisibile in area GRUPPI
        if (gruppoVal) {
            addChipIfNotExists(
                "@Html.Raw(nameof(AttoDASIDto.id_gruppo))",
                "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.id_gruppo))",
                gruppoVal, "", "", false, false
            );
        }

        // Filtri utente dal localStorage (escludi il gruppo che e' gia' stato aggiunto come chip
        // invisibile fissa e ignora eventuali chip salvate senza valore per evitare residui vuoti).
        var filtriUtente = filtriDasi.filter(function (f) {
            if (!f || f.key === "@Html.Raw(nameof(AttoDASIDto.id_gruppo))") return false;
            return f.val !== null && f.val !== undefined && String(f.val).trim() !== '';
        });

        // Ripristina le chip utente
        filtriUtente.forEach(function(filtro) {
            var visible = filtro.visible !== undefined ? filtro.visible : true;
            addChipIfNotExists(filtro.key, filtro.keyLabel, filtro.val, filtro.label, filtro.chipText, false, visible);
        });

        // Lancia ricerca se c'e' almeno una chip-utente ripristinata dalla cache.
        // Il guard dentro inviaDatiChips protegge comunque il caso "solo id_gruppo invisibile".
        if (filtriUtente.length > 0) {
            var paging = JSON.parse(localStorage.getItem('pagingDasi'));
            if (paging) {
                inviaDatiChips(paging.page, paging.size);
            } else {
                inviaDatiChips(1, 20);
            }
        }
        // Senza chip-utente: pannello cortesia resta visibile
    }

    function ripristinaFiltriTrattazione() {
        $('#chips-container').empty();

        var filtriDasi = JSON.parse(localStorage.getItem('filtriDasi')) || [];

        const idSeduta = getUrlParameter('id');
        const tipo = getUrlParameter('tipo');
        const uidAtto = getUrlParameter('uidAtto');
        const legislatura = getUrlParameter('legislatura');

        var defaultFiltri = [
            {
                key: "@Html.Raw(nameof(AttoDASIDto.UIDSeduta))",
                keyLabel: "",
                val: idSeduta || "",
                label: "",
                chipText: "",
                visible: false
            },
            {
                key: "@Html.Raw(nameof(AttoDASIDto.Tipo))",
                keyLabel: "",
                val: tipo || "",
                label: "",
                chipText: "",
                visible: false
            },
            {
                key: "@Html.Raw(nameof(AttoDASIDto.Abbinamenti))",
                keyLabel: "",
                val: uidAtto || "",
                label: "",
                chipText: "",
                visible: false
            },
            {
                key: "@Html.Raw(nameof(AttoDASIDto.Legislatura))",
                keyLabel: "",
                val: legislatura || "",
                label: "",
                chipText: "",
                visible: false
            }
        ];

        const defaultKeys = new Set(defaultFiltri.map(f => f.key));

        const filtriUtente = (filtriDasi || []).filter(f => !defaultKeys.has(f.key));

        const visti = new Set();
        const nuoviFiltri = [...defaultFiltri, ...filtriUtente].filter(f => {
            if (visti.has(f.key)) return false;
            visti.add(f.key);
            return true;
        });

        nuoviFiltri.forEach(function(filtro) {
            var visible = filtro.visible ?? true;
            addChipIfNotExists(filtro.key, filtro.keyLabel, filtro.val, filtro.label, filtro.chipText, false, visible);
        });
        const paging = JSON.parse(localStorage.getItem('pagingDasi'));
        if (paging) {
            inviaDatiChips(paging.page, paging.size);
        } else {
            inviaDatiChips(1, 20);
        }
    }

    function ripristinaOrdinamento() {
        $('#chips-container-sorting').empty();
        const ordinamenti = JSON.parse(localStorage.getItem('selectedSortColumns'));
        if (ordinamenti) {
            ordinamenti.forEach(function(ordinamento) {
                addSortChipIfNotExists(ordinamento.propertyName, ordinamento.sortDirection, ordinamento.displayText);
            });
        }
    }

    function addSortChipIfNotExists(key, sortDirection, chipText) {

        var existingChip = document.querySelector(`.chip[data-orderby="${key}"]`);

        if (!existingChip) {
            var chipsContainer = document.getElementById('chips-container-sorting');
            var newChip = document.createElement('div');
            newChip.setAttribute('data-order-direction', sortDirection);
            newChip.setAttribute('data-orderby', key);
            newChip.classList.add('chip');
            newChip.classList.add('order-chip');
            newChip.classList.add('amber');
            newChip.classList.add('black-text');

            var directionText = "";
            if (sortDirection == "-1")
                directionText = "Decrescente";
            else
                directionText = "Crescente";

            newChip.textContent = "Ordinato per " + chipText + " " + directionText;

            var editIcon = document.createElement('i');
            editIcon.classList.add('material-icons', 'tiny');
            editIcon.style.setProperty('margin-left', '10px');
            editIcon.style.setProperty('top', '2px');
            editIcon.textContent = 'edit';

            newChip.onclick = async function(event) {
                event.stopPropagation();
                openOrdinamentoModal();
            };
            newChip.appendChild(editIcon);

            chipsContainer.appendChild(newChip);
        } else {
            existingChip.setAttribute('data-order-direction', sortDirection);
            existingChip.setAttribute('data-orderby', key);
            existingChip.textContent = chipText;
        }
    }

    function filterByPage(page) {
        inviaDatiChips(page, $("#hdPaginazioneCorrente").val());
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function filterBySize(page, size) {
        inviaDatiChips(page, size);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function initPreviewUI() {
        const view = localStorage.getItem('viewModeDasi');
        if (view) {
            $("#btnGoToPreviewAdmin").show();
            if (view == @Html.Raw((int)ViewModeEnum.GRID)) {
                $("#btnGoToPreviewAdmin").html('<i class="material-icons">desktop_windows</i>');
                $("#btnGoToPreviewAdmin").attr('data-tooltip', 'Visualizza Atti in preview');
            } else if (view == @Html.Raw((int)ViewModeEnum.PREVIEW)) {
                $("#btnGoToPreviewAdmin").html('<i class="material-icons">developer_board</i>');
                $("#btnGoToPreviewAdmin").attr('data-tooltip', 'Visualizza Atti in griglia');
            }
            M.Tooltip.init($("#btnGoToPreviewAdmin"));
        } else {
            $("#btnGoToPreviewAdmin").hide();
        }
    }

    function gotoPreviewModeAdmin() {
        const view = localStorage.getItem('viewModeDasi');
        if (view) {
            if (view == @Html.Raw((int)ViewModeEnum.GRID)) {
                localStorage.setItem('viewModeDasi', @Html.Raw((int)ViewModeEnum.PREVIEW));
            } else if (view == @Html.Raw((int)ViewModeEnum.PREVIEW)) {
                localStorage.setItem('viewModeDasi', @Html.Raw((int)ViewModeEnum.GRID));
            }
        } else {
            localStorage.setItem('viewModeDasi', @Html.Raw((int)ViewModeEnum.GRID));
        }
        console.log("previeMode");
        inviaDatiChips(1, $("#hdPaginazioneCorrente").val());
    }
</script>

