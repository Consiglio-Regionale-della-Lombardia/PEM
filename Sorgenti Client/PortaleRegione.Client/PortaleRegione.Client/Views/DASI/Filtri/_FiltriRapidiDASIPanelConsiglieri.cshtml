            var firmeChip = '';
            if (result.ConteggioFirme > 1) {
                firmeChip = `<a class='chip tooltipped blue darken-3 white-text' data-position='left' data-tooltip='${result.Firme}' style="margin-left: 10px; min-width: unset;">
+ ${result.ConteggioFirme - 1} <i class='icon material-icons right' style="margin-left: unset; margin-right: -5px;">group</i>
</a>`;
            }

            var iconChipAggiuntiva = "";
            if (result.Tipo == @Html.Raw((int)TipoAttoEnum.MOZ) && result.TipoMOZ == @Html.Raw((int)TipoMOZEnum.ABBINATA)) {
                iconChipAggiuntiva += `<i class="close material-icons blue-text tooltipped" data-position="bottom" data-tooltip="Proposta di abbinata" aria-label="Proposta di abbinata">insert_link</i>`;
            }

            if (result.Tipo == @Html.Raw((int)TipoAttoEnum.ODG) && result.ODG_Atto_PEM) {
                iconChipAggiuntiva += `<i class="close material-icons blue-text tooltipped" data-position="bottom" data-tooltip="Proposta di abbinata" aria-label="Proposta di abbinata">insert_link</i>`;
            }

            if (result.PresentatoOltreITermini == true) {
                iconChipAggiuntiva += `<i class="close material-icons orange-text tooltipped" data-position="bottom" data-tooltip="Presentato oltre i termini" aria-label="Presentato oltre i termini">warning</i>`;
            }

            if (result.Privacy == true || result.Privacy_Divieto_Pubblicazione) {
                iconChipAggiuntiva += `<i class="close material-icons red-text tooltipped" data-position="bottom" data-tooltip="Modificato per privacy" aria-label="Modificato per privacy">lock</i>`;
            }

            if (result.Tipo == @Html.Raw((int)TipoAttoEnum.MOZ) && result.TipoMOZ == @Html.Raw((int)TipoMOZEnum.URGENTE)) {
                iconChipAggiuntiva += `<i class="close material-icons red-text tooltipped" data-position="bottom" data-tooltip="Mozione urgente" aria-label="Mozione urgente">priority_high</i>`;
            }

            if (result.Tipo == @Html.Raw((int)TipoAttoEnum.MOZ) && result.TipoMOZ == @Html.Raw((int)TipoMOZEnum.SFIDUCIA)) {
                iconChipAggiuntiva += `<i class="close material-icons red-text tooltipped" data-position="bottom" data-tooltip="Mozione sfiducia" aria-label="Mozione sfiducia">thumb_down</i>`;
            }

            if (result.Tipo == @Html.Raw((int)TipoAttoEnum.MOZ) && result.TipoMOZ == @Html.Raw((int)TipoMOZEnum.CENSURA)) {
                iconChipAggiuntiva += `<i class="close material-icons red-text tooltipped" data-position="bottom" data-tooltip="Mozione censura" aria-label="Mozione censura">speaker_notes_off</i>`;
            }

            var oggetto = '';
            if (result.Oggetto_Approvato != null && result.Oggetto_Approvato != "") {
                oggetto = result.Oggetto_Approvato;
            } else if (result.Oggetto_Modificato != null && result.Oggetto_Modificato != "") {
                oggetto = result.Oggetto_Modificato;
            } else {
                oggetto = result.Oggetto;
            }

            var clientMode = localStorage.getItem('clientMode');
            var comandiHTML = '';
            if (clientMode == @Html.Raw((int)ClientModeEnum.GRUPPI)) {
                if (result.Firmabile) {
                    comandiHTML += `<button type="button" role="button" class="btn-flat green-text" onclick="RevealFirmaDepositoDASI('${result.UIDAtto}', @Html.Raw((int)ActionEnum.FIRMA))">Firma</button>`;
                }
                if (result.Presentabile) {
                    comandiHTML += `<button type="button" role="button" class="btn-flat purple-text" onclick="RevealFirmaDepositoDASI('${result.UIDAtto}', @Html.Raw((int)ActionEnum.DEPOSITA))">Deposita</button>`;
                }
            } else {
                if (result.Firmabile) {
                    comandiHTML += `<button type="button" role="button" class="btn-flat green-text" onclick="RevealFirmaDepositoDASI('${result.UIDAtto}', @Html.Raw((int)ActionEnum.FIRMA))">Firma</button>`;
