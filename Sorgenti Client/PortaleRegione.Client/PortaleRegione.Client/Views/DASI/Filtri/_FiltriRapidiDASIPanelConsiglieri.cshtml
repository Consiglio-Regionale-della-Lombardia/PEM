        const ul = document.createElement('ul');
        ul.className = 'collapsible expandable';

        responseData.Data.Results.forEach(result => {

            var htmlFirme = '';
            if (result.id_gruppo != 0) {
                if (result.Firmato_Dal_Proponente == false) {
