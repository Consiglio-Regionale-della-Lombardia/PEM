    Html.RenderPartial("Filtri/_DettaglioFiltroModal", Model);
    Html.RenderPartial("Filtri/_FiltroConfigModal", Model);
    Html.RenderPartial("Filtri/_ReportConfigModalConsiglieri", Model);
    Html.RenderPartial("Filtri/_OrdinamentoColonneConsiglieri", Model);
}
