}

<script>
    var selectedSortColumns = [];
    var gridCollapsibleInstance = null;

    var availableFilterArray = [
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.Legislatura))", id: "@nameof(AttoDASIDto.Legislatura)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.IDStato))", id: "@nameof(AttoDASIDto.IDStato)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.Tipo))", id: "@nameof(AttoDASIDto.Tipo)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.IDTipo_Risposta))", id: "@nameof(AttoDASIDto.IDTipo_Risposta)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.NAtto))", id: "@nameof(AttoDASIDto.NAtto)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.Timestamp))", id: "@nameof(AttoDASIDto.Timestamp)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.UIDSeduta))", id: "@nameof(AttoDASIDto.UIDSeduta)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.DataIscrizioneSeduta))", id: "@nameof(AttoDASIDto.DataIscrizioneSeduta)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.UIDPersonaProponente))", id: "@nameof(AttoDASIDto.UIDPersonaProponente)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.TipoMOZ))", id: "@nameof(AttoDASIDto.TipoMOZ)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.Abbinamenti))", id: "@nameof(AttoDASIDto.Abbinamenti)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.Firme))", id: "@nameof(AttoDASIDto.Firme)" },
        { tag: "Oggetto e Testo", id: "@nameof(AttoDASIDto.Oggetto)" },
        { tag: "Atti da firmare", id: "AttiDaFirmare" },
    ];

    var availableFilterTrattazioneArray = [
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.NAtto))", id: "@nameof(AttoDASIDto.NAtto)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.UIDPersonaProponente))", id: "@nameof(AttoDASIDto.UIDPersonaProponente)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.id_gruppo))", id: "@nameof(AttoDASIDto.id_gruppo)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.id_gruppo_firmatari))", id: "@nameof(AttoDASIDto.id_gruppo_firmatari)" },
        { tag: "@Utility.GetDisplayName(typeof(AttoDASIDto), nameof(AttoDASIDto.Firme))", id: "@nameof(AttoDASIDto.Firme)" },
        { tag: "Oggetto e Testo", id: "@nameof(AttoDASIDto.Oggetto)" },
    ];

    var chipsKeys = {};

    // Handler "Seleziona tutto" per la griglia dinamica
    function checkAllFunc(ctrl) {
        var isChecked = $(ctrl).prop('checked');
        setSelezionaTutti_DASI(isChecked);
        setListaAtti([]);
        $('input[id^="chk_Atto_"]').not($(ctrl)).prop('checked', isChecked);
        AbilitaComandiMassivi_DASI(null);
    }

    // Handler "Espandi tutti" per la griglia dinamica (bind una sola volta a DOM ready)
    $(function() {
        $(document).on('change', '#expandAll', function() {
            if (!gridCollapsibleInstance) return;
            var items = document.querySelectorAll('#tableResults > ul.collapsible > li');
            var opening = $(this).is(':checked');
            for (var i = 0; i < items.length; i++) {
                if (opening) {
                    gridCollapsibleInstance.open(i);
                } else {
                    gridCollapsibleInstance.close(i);
                }
            }
        });
    });

    // Picker multi-selezione persone (pattern PEM: lista visibile + search real-time + chips).
    // config = { prefix, dataAttr, persone, isEditing, currentValue }
    //   prefix    -> usato per id container ("${prefix}-search", "${prefix}-chips", "${prefix}-list") e classe item ("${prefix}-item")
    //   dataAttr  -> nome attributo dati sulle chip generate (es. "proponente-uid" -> data-proponente-uid)
    //   persone   -> array [{ uid, DisplayName }]
    //   currentValue stringa GUID separati da virgola (solo se isEditing)
    function setupPersonePickerDASI(config) {
        var prefix = config.prefix;
        var dataAttr = config.dataAttr;
        var persone = config.persone || [];
        var itemClass = prefix + '-item';

        var html = '<div id="modal-' + prefix + '-container">' +
            '<div class="input-field col s12">' +
                '<input id="' + prefix + '-search" type="text" placeholder="Cerca persona...">' +
                '<label for="' + prefix + '-search" class="active">Cerca</label>' +
            '</div>' +
            '<div id="' + prefix + '-chips"></div>' +
            '<div id="' + prefix + '-list" class="collection" style="max-height:300px;overflow-y:auto">';
        persone.forEach(function(p) {
            html += '<a class="collection-item ' + itemClass + '" data-uid="' + p.uid + '" href="#">' + p.DisplayName + '</a>';
        });
        html += '</div></div>';
        document.getElementById('dynamic-select-container').innerHTML = html;

        var searchInput = document.getElementById(prefix + '-search');
        var chipsContainer = document.getElementById(prefix + '-chips');
        var listItems = document.querySelectorAll('.' + itemClass);

        function addChip(uid, name) {
            if (chipsContainer.querySelector('[data-' + dataAttr + '="' + uid + '"]')) return;
            var chip = document.createElement('div');
            chip.classList.add('chip');
            chip.setAttribute('data-' + dataAttr, uid);
            chip.textContent = name;
            var closeIcon = document.createElement('i');
            closeIcon.classList.add('close', 'material-icons');
            closeIcon.style.setProperty('top', 'unset', 'important');
            closeIcon.textContent = 'close';
            closeIcon.onclick = function() { chip.remove(); };
            chip.appendChild(closeIcon);
            chipsContainer.appendChild(chip);
        }

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                var query = this.value.toLowerCase();
                listItems.forEach(function(item) {
                    item.style.display = item.textContent.toLowerCase().indexOf(query) !== -1 ? '' : 'none';
                });
            });
        }

        listItems.forEach(function(item) {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                addChip(item.getAttribute('data-uid'), item.textContent.trim());
            });
        });

        if (config.isEditing && config.currentValue) {
            config.currentValue.split(',').forEach(function(guid) {
                var p = persone.find(function(x) { return x.uid === guid; });
                if (p) addChip(p.uid, p.DisplayName);
            });
        }
    }

    @{
        var defaultKeysConsiglieriList = new List<string>
        {
            nameof(AttoDASIDto.id_gruppo)
        };
    }
    var defaultKeysConsiglieri = new Set(@Html.Raw(JsonConvert.SerializeObject(defaultKeysConsiglieriList)));

    document.addEventListener('DOMContentLoaded',
        async function() {
            document.getElementById('loadingSpinner').style.display = 'none';
            var clientMode = localStorage.getItem('clientMode');
            if (clientMode != @Html.Raw((int)Model.ClientMode)) {
                localStorage.setItem('clientMode', @Html.Raw((int)Model.ClientMode));
            }

            var dataSource = clientMode == @Html.Raw((int)ClientModeEnum.TRATTAZIONE)
                ? availableFilterTrattazioneArray
                : availableFilterArray;

            var elems = document.querySelectorAll('#autocomplete-input');
            var instances = M.Autocomplete.init(elems,
                {
                    data: dataSource,
                    onAutocomplete: async function(txt, key) {
                        await openModalWithContent(key, txt, false, 0);
                    }
                });

            if (document.getElementById('autocomplete-input')) {
                document.getElementById('autocomplete-input').addEventListener('keydown',
                    function(event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            var autocompleteList = document.querySelectorAll('.autocomplete-content.dropdown-content li');
                            if (autocompleteList.length > 0 && !autocompleteList[0].classList.contains('disabled')) {
                                autocompleteList[0].click();
                            }
                        }
                    });
            }

            if (clientMode == @Html.Raw((int)ClientModeEnum.TRATTAZIONE)) {
                console.log("### TRATTAZIONE ###");

                ripristinaFiltriTrattazione();
                ripristinaOrdinamento();

                await creaPannelloFiltriLaterale2();
            } else {
                console.log("### GRUPPI ###");
                var filtriFromStorage = localStorage.getItem('filtriDasi');
                if (filtriFromStorage) {
                    const filtri = JSON.parse(filtriFromStorage);
                    const filtriConKeyLabel = filtri.filter(filtro => filtro.keyLabel && filtro.keyLabel.trim() !== '');
                    localStorage.setItem('filtriDasi', JSON.stringify(filtriConKeyLabel));
                } else {
                    localStorage.setItem('filtriDasi', JSON.stringify([]));
                }

                ripristinaFiltri();
                ripristinaOrdinamento();

                await creaPannelloFiltriLaterale2();

                await ripristinaPreferiti();
                await ripristinaReports();

                creaPannelloReportLaterale();
            }

            document.getElementById('addFiltersButton').addEventListener('click',
                function() {
                    var key = document.getElementById('modal-filter-id-hidden').value;
                    var keyLabel = document.getElementById('modal-content').textContent;
                    var val, text, chipText;

                    if (key === "@nameof(AttoDASIDto.NAtto)") {
                        val = document.getElementById('n_atto').value;
                        text = val;
                        chipText = keyLabel + ": " + val;
                    } else if (key === "@nameof(AttoDASIDto.Oggetto)") {
                        val = document.getElementById('oggetto').value;
                        text = val;
                        chipText = keyLabel + ": " + val;
                    } else if (key === "@nameof(AttoDASIDto.Legislatura)") {
                        var selectedOptions = document.querySelectorAll('#legislature-select option:checked');
                        var values = Array.from(selectedOptions).map(option => option.value);
                        var texts = Array.from(selectedOptions).map(option => option.text);
                        val = values.join(',');
                        text = texts.join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.IDStato)") {
                        var selectedOptions = document.querySelectorAll('#stati-select option:checked');
                        var values = Array.from(selectedOptions).map(option => option.value);
                        var texts = Array.from(selectedOptions).map(option => option.text);
                        val = values.join(',');
                        text = texts.join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.Tipo)") {
                        var selectedOptions = document.querySelectorAll('#tipi-select option:checked');
                        var values = Array.from(selectedOptions).map(option => option.value);
                        var texts = Array.from(selectedOptions).map(option => option.text);
                        val = values.join(',');
                        text = texts.join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.IDTipo_Risposta)") {
                        var selectedOptions = document.querySelectorAll('#tipi-risposta-select option:checked');
                        var values = Array.from(selectedOptions).map(option => option.value);
                        var texts = Array.from(selectedOptions).map(option => option.text);
                        val = values.join(',');
                        text = texts.join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.Timestamp)") {
                        text = "";
                        val = "";
                        var data_da_str = document.getElementById('data_presentazione_da').value;
                        var date_da_obj = new Date(data_da_str);
                        if (!isNaN(date_da_obj.getTime())) {
                            var data_da_formatted_date = ('0' + date_da_obj.getDate()).slice(-2) + '/' + ('0' + (date_da_obj.getMonth() + 1)).slice(-2) + '/' + date_da_obj.getFullYear();
                            val = data_da_formatted_date;
                            text = data_da_formatted_date;
                        }
                        if (document.getElementById('data_presentazione_a').value !== '') {
                            var data_a_str = document.getElementById('data_presentazione_a').value;
                            var date_a_obj = new Date(data_a_str);
                            if (!isNaN(date_a_obj.getTime())) {
                                var data_a_formatted_date = ('0' + date_a_obj.getDate()).slice(-2) + '/' + ('0' + (date_a_obj.getMonth() + 1)).slice(-2) + '/' + date_a_obj.getFullYear();
                                val += "," + data_a_formatted_date;
                                text = " dal " + data_da_formatted_date + " al " + data_a_formatted_date;
                            }
                        }
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.UIDSeduta)") {
                        text = "";
                        val = "";
                        var data_da_str = document.getElementById('data_seduta_da').value;
                        var date_da_obj = new Date(data_da_str);
                        if (!isNaN(date_da_obj.getTime())) {
                            var data_da_formatted_date = ('0' + date_da_obj.getDate()).slice(-2) + '/' + ('0' + (date_da_obj.getMonth() + 1)).slice(-2) + '/' + date_da_obj.getFullYear();
                            val = data_da_formatted_date;
                            text = data_da_formatted_date;
                        }
                        if (document.getElementById('data_seduta_a').value !== '') {
                            var data_a_str = document.getElementById('data_seduta_a').value;
                            var date_a_obj = new Date(data_a_str);
                            if (!isNaN(date_a_obj.getTime())) {
                                var data_a_formatted_date = ('0' + date_a_obj.getDate()).slice(-2) + '/' + ('0' + (date_a_obj.getMonth() + 1)).slice(-2) + '/' + date_a_obj.getFullYear();
                                val += "," + data_a_formatted_date;
                                text = " dal " + data_da_formatted_date + " al " + data_a_formatted_date;
                            }
                        }
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.DataIscrizioneSeduta)") {
                        text = "";
                        val = "";
                        var data_iscrizione_seduta_str = document.getElementById('data_iscrizione_seduta_da').value;
                        var data_iscrizione_seduta_obj = new Date(data_iscrizione_seduta_str);
                        if (!isNaN(data_iscrizione_seduta_obj.getTime())) {
                            var data_iscrizione_seduta_formatted_date = ('0' + data_iscrizione_seduta_obj.getDate()).slice(-2) + '/' + ('0' + (data_iscrizione_seduta_obj.getMonth() + 1)).slice(-2) + '/' + data_iscrizione_seduta_obj.getFullYear();
                            val = data_iscrizione_seduta_formatted_date;
                            text = data_iscrizione_seduta_formatted_date;
                        }
                        if (document.getElementById('data_iscrizione_seduta_a').value !== '') {
                            var data_a_str = document.getElementById('data_iscrizione_seduta_a').value;
                            var date_a_obj = new Date(data_a_str);
                            if (!isNaN(date_a_obj.getTime())) {
                                var data_a_formatted_date = ('0' + date_a_obj.getDate()).slice(-2) + '/' + ('0' + (date_a_obj.getMonth() + 1)).slice(-2) + '/' + date_a_obj.getFullYear();
                                val += "," + data_a_formatted_date;
                                text = " dal " + data_iscrizione_seduta_formatted_date + " al " + data_a_formatted_date;
                            }
                        }
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.UIDPersonaProponente)") {
                        text = "";
                        val = "";
                        var existingChips = document.querySelectorAll('.chip[data-proponente-uid]');
                        existingChips.forEach(function(item, index) {
                            var chipInnerText = Array.from(item.childNodes)
                                .filter(node => node.nodeType === Node.TEXT_NODE)
                                .map(node => node.textContent.trim())
                                .join('');
                            if (index > 0) {
                                text += ", ";
                                val += ",";
                            }
                            text += chipInnerText;
                            val += item.getAttribute('data-proponente-uid');
                        });
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.Firme)") {
                        text = "";
                        val = "";
                        var existingChips = document.querySelectorAll('.chip[data-firme-uid]');
                        existingChips.forEach(function(item, index) {
                            var chipInnerText = Array.from(item.childNodes)
                                .filter(node => node.nodeType === Node.TEXT_NODE)
                                .map(node => node.textContent.trim())
                                .join('');
                            if (index > 0) {
                                text += ", ";
                                val += ",";
                            }
                            text += chipInnerText;
                            val += item.getAttribute('data-firme-uid');
                        });
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.Abbinamenti)") {
                        text = "";
                        val = "";
                        var existingChips = document.querySelectorAll('.chip[data-abbinamento-uid]');
                        existingChips.forEach(function(item, index) {
                            var chipInnerText = Array.from(item.childNodes)
                                .filter(node => node.nodeType === Node.TEXT_NODE)
                                .map(node => node.textContent.trim())
                                .join('');
                            if (index > 0) {
                                text += ", ";
                                val += ",";
                            }
                            text += chipInnerText;
                            val += item.getAttribute('data-abbinamento-uid');
                        });
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(AttoDASIDto.TipoMOZ)") {
                        var selectedOption = document.querySelector('#tipi-mozione-select');
                        val = selectedOption.options[selectedOption.selectedIndex].value;
                        text = selectedOption.options[selectedOption.selectedIndex].text;
                        chipText = keyLabel + ": " + text;
                    } else if (key === "AttiDaFirmare") {
                        val = document.getElementById('atti-da-firmare').checked;
                        text = val ? 'Si' : 'No';
                        chipText = "Atti da firmare: " + text;
                    } else {
                        var selectedOption = document.querySelector('#dynamic-select-container select');
                        val = selectedOption.options[selectedOption.selectedIndex].value;
                        text = selectedOption.options[selectedOption.selectedIndex].text;
                        chipText = keyLabel + ": " + text;
                    }

                    addChipIfNotExists(key, keyLabel, val, text, chipText, true, true);
                    resetSelezionePreferiti();
                    $('#infoModal').modal("close");
                });
        });

    async function inviaDatiChips(page, size) {
        console.log("INVIO DATI");
        if (!page) {
            page = 1;
        }
        if (!size) {
            size = 20;
        }

        var view = localStorage.getItem('viewModeDasi');
        if (!view) {
            localStorage.setItem('viewModeDasi', @Html.Raw((int)ViewModeEnum.GRID));
            view = localStorage.getItem('viewModeDasi');
        }

        var clientMode = localStorage.getItem('clientMode');
        if (!clientMode) {
            localStorage.setItem('clientMode', @Html.Raw((int)ClientModeEnum.GRUPPI));
            clientMode = localStorage.getItem('clientMode');
        }

        var paging = {};
        paging.page = page;
        paging.size = size;
        localStorage.setItem('pagingDasi', JSON.stringify(paging));

        document.getElementById('tableResults').innerHTML = "";
        document.getElementById('paginazione-container-top').innerHTML = "";
        document.getElementById('loadingSpinner').style.display = 'block';

        var request = {};
        var chipsData = [];
        document.querySelectorAll('#chips-container .chip.filter-chip').forEach(function(chip) {
            if (chip.getAttribute('data-val').indexOf("Non vuoto") !== -1) {
                chipsData.push({
                    property: chip.getAttribute('data-filterby'),
                    value: '',
                    not_empty: true
                });
            } else {
                chipsData.push({
                    property: chip.getAttribute('data-filterby'),
                    value: chip.getAttribute('data-val')
                });
            }
        });

        // Gate GRUPPI: se l'utente non ha nessuna chip VISIBILE (rimane solo la chip invisibile id_gruppo),
        // non inviare richiesta al server e mostra il messaggio di cortesia.
        if (clientMode != @Html.Raw((int)ClientModeEnum.TRATTAZIONE)) {
            var visibleChipsCount = document.querySelectorAll('#chips-container .chip.filter-chip:not([style*="display: none"])').length;
            if (visibleChipsCount === 0) {
                document.getElementById('tableResults').innerHTML = `<div class="card-panel blue lighten-5 center">
<span class="center">
    <p>Esegui una ricerca per poter visualizzare gli atti</p>
</span>
</div>`;
                document.getElementById('paginazione-container-top').innerHTML = "";
                var comandiGriglia = document.getElementById('comandiGriglia');
                if (comandiGriglia) comandiGriglia.style.display = 'none';
                document.getElementById('loadingSpinner').style.display = 'none';
                waiting(false);
                return;
            }
        }

        // Guard: in area GRUPPI, inietta sempre il filtro gruppo del consigliere
        var _clientMode = localStorage.getItem('clientMode');
        if (_clientMode != @Html.Raw((int)ClientModeEnum.TRATTAZIONE)) {
            var _gruppoGuard = '@Html.Raw(Model.CurrentUser?.Gruppo != null ? Model.CurrentUser.Gruppo.id_gruppo.ToString() : "")';
            if (_gruppoGuard && !chipsData.some(function(c) { return c.property === "@Html.Raw(nameof(AttoDASIDto.id_gruppo))"; })) {
                chipsData.push({ property: "@Html.Raw(nameof(AttoDASIDto.id_gruppo))", value: _gruppoGuard });
            }
        }

        try {
            request.filters = chipsData;
            request.page = page;
            request.size = size;
            request.viewMode = view;
            request.clientMode = clientMode;

            const savedSortColumns = JSON.parse(localStorage.getItem('selectedSortColumns')) || [];
            request.sort_settings = savedSortColumns;

            const selectedColumns = JSON.parse(localStorage.getItem('selectedColumns')) || [];
            request.columns_settings = [];
            selectedColumns.forEach(function(item) {
                request.columns_settings.push(item.propertyName);
            });

            const response = await fetch('@Url.Action("Riepilogo")',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(request)
                });

            if (!response.ok) {
                throw new Error('Network response was not ok');
            }

            responseData = await response.json();
            if (responseData.message) {
                ErrorAlert(responseData.message);
                return;
            }

            if (responseData.Data && responseData.Data.Results && responseData.Data.Results.length > 0) {
                CreaTabella();
            } else {
                if (chipsData.length == 0) {
                    document.getElementById('tableResults').innerHTML = `<div class="card-panel blue lighten-5 center">
<span class="center">
    <p>Esegui una ricerca per poter visualizzare gli atti</p>
</span>
</div>`;
                } else {
                    document.getElementById('tableResults').innerHTML = `<div class="card-panel panel-warning center">
<span class="center">
     <p>Nessun atto trovato</p>
</span>
</div>`;
                }
            }
            creaPaginazione(responseData);
            AggiornaContatori(responseData);
            document.getElementById('loadingSpinner').style.display = 'none';
        } catch (error) {
            document.getElementById('loadingSpinner').style.display = 'none';
            console.error('Errore durante l\'invio dei dati delle chips:', error);
        }

        initPreviewUI();
        waiting(false);
    }

    async function inviaDatiChipsSoloIds(page, size) {
        if (!page) {
            page = 1;
        }
        if (!size) {
            size = 20;
        }

        var view = localStorage.getItem('viewModeDasi');
        var clientMode = localStorage.getItem('clientMode');

        var paging = {};
        paging.page = page;
        paging.size = size;

        var request = {};
        var chipsData = [];
        document.querySelectorAll('#chips-container .chip.filter-chip').forEach(function(chip) {
            if (chip.getAttribute('data-val').indexOf("Non vuoto") !== -1) {
                chipsData.push({
                    property: chip.getAttribute('data-filterby'),
                    value: '',
                    not_empty: true
                });
            } else {
                chipsData.push({
                    property: chip.getAttribute('data-filterby'),
                    value: chip.getAttribute('data-val')
                });
            }
        });

        try {
            request.filters = chipsData;
            request.page = page;
            request.size = size;
            request.viewMode = view;
            request.clientMode = clientMode;

            const savedSortColumns = JSON.parse(localStorage.getItem('selectedSortColumns')) || [];
            request.sort_settings = savedSortColumns;

            const response = await fetch('@Url.Action("RiepilogoSoloIds")',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(request)
                });

            if (!response.ok) {
                throw new Error('Network response was not ok');
            }

            responseData = await response.json();
            if (responseData.message) {
                ErrorAlert(responseData.message);
                return;
            }

            return responseData;
        } catch (error) {
            console.error('Errore durante l\'invio dei dati delle chips solo ids:', error);
        }
    }

