@using PortaleRegione.DTO.Enum

@*
    Modale "Genera report" semplificato per il modulo Emendamenti.
    Versione minimale: l'utente sceglie solo il formato (Excel o Word). Le colonne,
    il tipo di visualizzazione, la copertina, i template e il salvataggio del report
    come preferito sono stati rimossi: il report viene generato sempre con il layout
    standard dell'export PEM.
    Il PDF non e' coperto dalla pipeline corrente e viene quindi nascosto dal select.
*@

<div id="modalReportConfig" class="modal modal-fixed-footer">
    <div class="modal-content">
        <h4>Report</h4>
        <div id="chips-container-report-config"></div>
        <div id="chips-container-report-sort"></div>

        <div class="row">
            <div class="input-field col s12">
                <input placeholder="Es. Report seduta del 22/07" id="report_name" type="text" class="validate">
                <label for="report_name">Nome report</label>
            </div>
        </div>
        <div class="row">
            <div class="input-field col s12">
                <select name="exportFormat">
                    <option value="@Html.Raw((int)ExportFormatEnum.EXCEL)" selected>EXCEL</option>
                    <option value="@Html.Raw((int)ExportFormatEnum.WORD)">WORD</option>
                </select>
                <label>Formato esportazione</label>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn-flat modal-close">Annulla</button>
        <button type="button" id="btnGenerateReport" class="btn-flat pink-text">Genera report</button>
    </div>
</div>

<script>
    // Apertura modale: bottone "Genera report" del pannello filtri.
    if (document.getElementById('btnReportConfig')) {
        document.getElementById('btnReportConfig').addEventListener('click', function () {
            openModalGeneraReportEM();
        });
    }

    function openModalGeneraReportEM() {
        $('#report_name').val('');
        $('select[name="exportFormat"]').val('@Html.Raw((int)ExportFormatEnum.EXCEL)').formSelect();
        $('#chips-container-report-config').empty();
        $('#chips-container-report-sort').empty();

        // Riepiloga le chip filtro correnti (escludendo le chip fisse, identiche al "Salva filtro").
        var filtri = JSON.parse(localStorage.getItem('filtriChipsEM') || '[]');
        var fixedKeys = (typeof defaultKeysEM !== 'undefined' && defaultKeysEM)
            ? Array.from(defaultKeysEM)
            : ["UIDAtto"];
        filtri
            .filter(function (f) { return fixedKeys.indexOf(f.key) === -1 && f.chipText; })
            .forEach(function (f) { addChipReportConfigEM(f.chipText); });

        var savedSort = JSON.parse(localStorage.getItem('selectedSortColumnsEM') || '[]');
        savedSort.forEach(function (sortInfo) {
            addChipReportSortingEM('Ordinato per ' + sortInfo.displayText + ' '
                + (sortInfo.sortDirection == 1 ? "Crescente" : "Decrescente"));
        });

        $('#modalReportConfig').modal("open");
    }

    function addChipReportConfigEM(chipText) {
        var chipsContainer = document.getElementById('chips-container-report-config');
        var newChip = document.createElement('div');
        newChip.classList.add('chip', 'yellow', 'black-text');
        newChip.textContent = chipText;
        chipsContainer.appendChild(newChip);
    }

    function addChipReportSortingEM(chipText) {
        var chipsContainer = document.getElementById('chips-container-report-sort');
        var newChip = document.createElement('div');
        newChip.classList.add('chip', 'amber', 'black-text');
        newChip.textContent = chipText;
        chipsContainer.appendChild(newChip);
    }

    document.getElementById('btnGenerateReport').addEventListener('click', function () {
        if (typeof buildFilterRequestEM !== 'function') {
            console.error('buildFilterRequestEM non disponibile: il pannello filtri non e\' stato inizializzato.');
            return;
        }

        var payload = {
            Filter: buildFilterRequestEM(),
            ReportName: document.getElementById('report_name').value,
            ExportFormat: document.querySelector('select[name="exportFormat"]').value
        };

        var url = '@Url.Action("GeneraReport", "Emendamenti")';
        $.ajax({
            url: url,
            type: "POST",
            data: JSON.stringify(payload),
            contentType: "application/json; charset=utf-8",
            beforeSend: function () {
                waiting(true, "Elaborazione in corso...");
            },
            success: function (response) {
                if (response && response.message) {
                    swal({ title: "Errore", text: response.message, icon: "error" });
                    return;
                }
                var a = document.createElement("a");
                a.href = response;
                a.target = '_blank';
                document.body.appendChild(a);
                a.click();
                a.remove();
                $('#modalReportConfig').modal("close");
            },
            error: function (xhr, status, error) {
                console.error("Errore nella richiesta: " + status + ". Motivo: " + error);
                waiting(false);
            },
            complete: function () {
                waiting(false);
            }
        });
    });
</script>
