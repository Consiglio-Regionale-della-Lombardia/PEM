    // =============================================
    // Multi-picker helper
    // =============================================
    function setupMultiPickerEM(itemPrefix, containerPrefix, dataAttr) {
        var searchInput = document.getElementById(containerPrefix + '-search');
        var listItems = document.querySelectorAll('.' + itemPrefix + '-item');

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var query = this.value.toLowerCase();
                listItems.forEach(function (item) {
                    item.style.display = item.textContent.toLowerCase().indexOf(query) !== -1 ? '' : 'none';
                });
            });
        }

        listItems.forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                var uid = item.getAttribute('data-uid') || item.getAttribute('data-id');
                var name = item.textContent.trim();
                var chipsContainer = document.getElementById(containerPrefix + '-chips');
                if (chipsContainer.querySelector('[' + dataAttr + '="' + uid + '"]')) return;

                var chip = document.createElement('div');
                chip.classList.add('chip');
                chip.setAttribute(dataAttr, uid);
                chip.textContent = name;

                var closeIcon = document.createElement('i');
                closeIcon.classList.add('close', 'material-icons');
                closeIcon.textContent = 'close';
                closeIcon.onclick = function () { chip.remove(); };
                chip.appendChild(closeIcon);
                chipsContainer.appendChild(chip);
            });
        });
    }

    // =============================================
    // Chip management
    // =============================================
    // Identico al pattern DASI: addChipIfNotExists
    function addChipIfNotExistsEM(key, keyLabel, val, label, chipText, refresh, visible) {

        var existingChip = document.querySelector('.chip[data-filterby="' + key + '"]');

        if (!existingChip) {
            var chipsContainer = document.getElementById('chips-container');
            var newChip = document.createElement('div');
            newChip.setAttribute('data-val', val);
            newChip.setAttribute('data-label', label);
            newChip.setAttribute('data-filterby', key);
            newChip.setAttribute('data-filterby-label', keyLabel);
            newChip.classList.add('chip');
            newChip.classList.add('filter-chip');
            newChip.textContent = chipText;

            if (visible === false) {
                newChip.style.display = "none";
            }

            // Chip fisse: no icone edit/close
            if (!defaultKeysEM.has(key)) {
                addIconsToChipEM(newChip, key, keyLabel, val);
            }
            chipsContainer.appendChild(newChip);

            chipsKeysEM[key] = true;
        } else {
            existingChip.setAttribute('data-val', val);
            existingChip.setAttribute('data-label', label);
            existingChip.setAttribute('data-filterby', key);
            existingChip.setAttribute('data-filterby-label', keyLabel);
            existingChip.textContent = chipText;

            if (visible === false) {
                existingChip.style.display = "none";
            }

            // Chip fisse: no icone edit/close
            if (!defaultKeysEM.has(key)) {
                addIconsToChipEM(existingChip, key, keyLabel, val);
            }
        }

        salvaFiltriEM();

        if (refresh) {
            inviaDatiChipsEM(1);
        }
    }

    // Identico al pattern DASI: addIconsToChip
    function addIconsToChipEM(chip, key, keyLabel, val) {

        var editIcon = document.createElement('i');
        editIcon.classList.add('material-icons', 'tiny');
        editIcon.style.setProperty('margin-left', '10px');
        editIcon.style.setProperty('top', '2px');
        editIcon.textContent = 'edit';
        editIcon.onclick = async function (event) {
            event.stopPropagation();
            await openModalWithContentEM(key, keyLabel, true, val);
        };
        chip.appendChild(editIcon);

        var closeIcon = document.createElement('i');
        closeIcon.classList.add('close', 'material-icons');
        closeIcon.style.setProperty('top', 'unset', 'important');
        closeIcon.textContent = 'close';
        closeIcon.onclick = function () {
            delete chipsKeysEM[key];
            chip.remove();
            resetSelezionePreferitiEM();
            salvaFiltriEM();
            inviaDatiChipsEM(1);
        };
        chip.appendChild(closeIcon);
    }

    // Identico al pattern DASI: salvaFiltri (salva TUTTO, inclusi filtri default)
    function salvaFiltriEM() {
        var filtri = [];
        document.querySelectorAll('#chips-container .chip.filter-chip').forEach(function (chip) {
            var key = chip.getAttribute('data-filterby');
            var keyLabel = chip.getAttribute('data-filterby-label');
            var val = chip.getAttribute('data-val');
            var label = chip.getAttribute('data-label');
            var chipTextContent = chip.cloneNode(true);
            chipTextContent.querySelectorAll('.material-icons').forEach(function(icon) { icon.remove(); });
            var chipText = chipTextContent.textContent.trim();

            filtri.push({ key: key, keyLabel: keyLabel, val: val, label: label, chipText: chipText });
        });
        localStorage.setItem('filtriChipsEM', JSON.stringify(filtri));
    }

    // Identico al pattern DASI ripristinaFiltriTrattazione: merge default + utente
    function ripristinaFiltriEM() {
        $('#chips-container').empty();

        var filtriEM = JSON.parse(localStorage.getItem('filtriChipsEM')) || [];

        // Filtri default (fissi, non eliminabili dall'utente)
        @{
            var pdlLabel = Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.UIDAtto));
            var pdlAttoText = Utility.GetText_Tipo(Model.Atto.IDTipoAtto) + " " + Model.Atto.NAtto;
            var gruppiLabel = Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.id_gruppo));
            var gruppoVal = Model.CurrentUser?.Gruppo != null ? Model.CurrentUser.Gruppo.id_gruppo.ToString() : "";
            var addGruppoFisso = Model.Mode == ClientModeEnum.GRUPPI && !load_gruppi && Model.CurrentUser?.Gruppo != null;
        }
        var defaultFiltri = [
            { key: "@nameof(EmendamentiDto.UIDAtto)", keyLabel: "@pdlLabel", val: "@Model.Atto.UIDAtto", label: "@pdlAttoText", chipText: "@pdlLabel: @pdlAttoText", visible: true }
            @if (addGruppoFisso)
            {
                <text>,{ key: "@nameof(EmendamentiDto.id_gruppo)", keyLabel: "@gruppiLabel", val: "@gruppoVal", label: "", chipText: "", visible: false }</text>
            }
        ];

        // Chiavi default per escluderle dai filtri utente
        var defaultKeys = new Set(defaultFiltri.map(function(f) { return f.key; }));

        // Filtri utente = quelli in filtriEM con key NON di default
        var filtriUtente = (filtriEM || []).filter(function(f) { return !defaultKeys.has(f.key); });

        // Merge: prima i default, poi i filtri utente (evita duplicati per key)
        var visti = new Set();
        var nuoviFiltri = defaultFiltri.concat(filtriUtente).filter(function(f) {
            if (visti.has(f.key)) return false;
            visti.add(f.key);
            return true;
        });

        nuoviFiltri.forEach(function(filtro) {
            var visible = filtro.visible !== undefined ? filtro.visible : true;
            addChipIfNotExistsEM(filtro.key, filtro.keyLabel, filtro.val, filtro.label, filtro.chipText, false, visible);
        });
    }

    function ripristinaOrdinamentoEM() {
        $('#chips-container-sorting').empty();

        var ordinamenti = JSON.parse(localStorage.getItem('selectedSortColumnsEM')) || [];

        // L'ordinamento principale Presentazione/Votazione e' gestito dalle tab sopra la griglia,
        // quindi qui non si reinietta piu' un ordinamento predefinito: la chip "Ordinato per ..." resta
        // visibile solo se l'utente ha effettivamente impostato un ordinamento secondario dal modale.
        // Per sicurezza, se in localStorage sono rimasti residui di Presentazione/Votazione salvati
        // da versioni precedenti, li ripuliamo affinche' il ripristino funzioni come atteso.
        var residui = ordinamenti.filter(function (o) {
            return o && (o.propertyName === '@nameof(EmendamentiDto.OrdinePresentazione)'
                || o.propertyName === '@nameof(EmendamentiDto.OrdineVotazione)');
        });
        if (residui.length > 0) {
            ordinamenti = ordinamenti.filter(function (o) {
                return o && o.propertyName !== '@nameof(EmendamentiDto.OrdinePresentazione)'
                    && o.propertyName !== '@nameof(EmendamentiDto.OrdineVotazione)';
            });
            localStorage.setItem('selectedSortColumnsEM', JSON.stringify(ordinamenti));
        }

        ordinamenti.forEach(function (ordinamento) {
            addSortChipIfNotExistsEM(ordinamento.propertyName, ordinamento.sortDirection, ordinamento.displayText);
        });
    }

    // =============================================
    // Costruzione FilterRequestEM a partire dalle chip correnti.
    // Esposta globalmente (window.buildFilterRequestEM) per i flussi azioni massive/Genera Report.
    // =============================================
    window.buildFilterRequestEM = function () {
        var page = parseInt(document.getElementById('inputFilterPage').value || '1', 10);
        var size = parseInt(document.getElementById('inputFilterSize').value || '20', 10);
        var view = parseInt(document.getElementById('inputFilterView').value || '0', 10);
        var clientMode = parseInt(document.getElementById('hdMode').value || '1', 10);
        var ordine = parseInt(document.getElementById('inputFilterOrdine').value || '1', 10);

        var filters = [];
        document.querySelectorAll('#chips-container .chip.filter-chip').forEach(function (chip) {
            filters.push({
                property: chip.getAttribute('data-filterby'),
                value: chip.getAttribute('data-val')
            });
        });

        // UIDAtto e' sempre presente come filtro fisso anche quando la chip non e' visibile.
        if (!filters.some(function (f) { return f.property === 'UIDAtto'; })) {
            var attoUid = document.getElementById('inputFiltroAtto').value;
            if (attoUid) filters.push({ property: 'UIDAtto', value: attoUid });
        }

        return {
            filters: filters,
            page: page,
            size: size,
            viewMode: view,
            clientMode: clientMode,
            ordine: ordine,
            sort_settings: selectedSortColumnsEM || [],
            columns_settings: []
        };
    };

    // =============================================
    // Riepilogo asincrono: POST FilterRequestEM -> EmendamentiViewModel -> render JS della griglia.
    // =============================================
    window.inviaDatiChipsEM = async function (page) {
        if (page) document.getElementById('inputFilterPage').value = page;

        var request = window.buildFilterRequestEM();
        if (!request.filters || request.filters.length === 0) {
            document.getElementById('tableResults').innerHTML =
                '<div class="card-panel blue lighten-5 center">Aggiungi almeno un filtro per avviare la ricerca.</div>';
            return;
        }

        var spinner = document.getElementById('loadingSpinner');
        if (spinner) spinner.style.display = 'block';
        document.getElementById('tableResults').innerHTML = '';
        // Issue #1614: la barra di paginazione viene rigenerata da creaPaginazioneEM(), che prima
        // distrugge le istanze Tooltip. Svuotarla qui staccherebbe i nodi senza passare per destroy(),
        // lasciando orfani i .material-tooltip nel body (label "appese" tipo "Prossima pagina").

        try {
            var response = await fetch(baseUrl + '/emendamenti/riepilogoEM', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json; charset=utf-8' },
                body: JSON.stringify(request)
            });
            if (!response.ok) throw new Error('Errore di rete (' + response.status + ')');
            var data = await response.json();
            if (data && data.message) {
                if (typeof Error === 'function') Error(data);
                return;
            }
            window.responseData = data;
            CreaTabellaEM(data);
            if (typeof creaPaginazioneEM === 'function') creaPaginazioneEM(data);
        } catch (err) {
            console.error('inviaDatiChipsEM:', err);
            document.getElementById('tableResults').innerHTML =
                '<div class="card-panel red lighten-4 center">Errore durante il caricamento del riepilogo.</div>';
        } finally {
            if (spinner) spinner.style.display = 'none';
        }
    };

    // Rendering della griglia di riepilogo emendamenti. Replica le colonne del rendering Razor
    // originale (_GridView_Admin_RiepilogoEM.cshtml): note, ordine, EM, data deposito, stato,
    // tipo, parte, articolo/comma/lettera, titolo/capo, missione/programma/titoloM, area politica,
    // firme (proponente + chip conteggio), comandi (stampa/edit/view).
    function CreaTabellaEM(data) {
        var container = document.getElementById('tableResults');
        if (!data || !data.Data || !data.Data.Results) {
            container.innerHTML = '<div class="card-panel grey lighten-4 center">Nessun emendamento trovato.</div>';
            return;
        }

        var results = data.Data.Results;
        // Il backend espone esplicitamente in EmendamentiSaltati gli identificatori degli
        // emendamenti che non e' riuscito a mappare (es. IDStato corrotto). Manteniamo anche
        // il conteggio dei null in Data.Results come ripiego per i flussi non aggiornati.
        var saltatiList = (data.EmendamentiSaltati && data.EmendamentiSaltati.length)
            ? data.EmendamentiSaltati
            : results.filter(function (em) { return em == null; }).map(function () { return '(non identificato)'; });
        var emSaltati = saltatiList.length;
        if (results.length === 0) {
            container.innerHTML = '<div class="card-panel panel-warning center">Non ci sono emendamenti al momento</div>';
            try { aggiornaComandiGrigliaEM(data); } catch (e) { /* ignored */ }
            return;
        }

        var ordinamento = data.Ordinamento != null ? data.Ordinamento : 1; // 1=Presentazione, 2=Votazione, 3=Default
        var attoVisMisProg = data.Atto && data.Atto.VIS_Mis_Prog === true;

        aggiornaComandiGrigliaEM(data);

        // ViewMode (cfr. ViewModeEnum): GRID = 0, PREVIEW = 1. In preview rendiamo card con il
        // corpo HTML dell'emendamento (BodyEM popolato dal backend quando ViewMode == PREVIEW).
        var viewMode = data.ViewMode != null ? data.ViewMode : @((int)ViewModeEnum.GRID);
        if (viewMode === @((int)ViewModeEnum.PREVIEW)) {
            container.innerHTML = renderPreviewListaEM(results, emSaltati, saltatiList);
            return;
        }

        // GRID: per Amministratore_PEM e Segreteria_Assemblea uso la tabella full con tutte le
        // colonne metadati; per consiglieri/assessori uso la vista a card originale (replica
        // fedele di _GridView_RiepilogoEM.cshtml).
        if (!@(load_gruppi ? "true" : "false")) {
            container.innerHTML = renderCardConsigliereListaEM(results, data.Mode, emSaltati, saltatiList);
            return;
        }

        var html = '<table class="highlight">';
        html += '<thead><tr>'
            + '<th></th>'
            + '<th></th>'
            + '<th></th>'
            + '<th><i class="icon material-icons">low_priority</i></th>'
            + '<th id="thNumeroEM">EM</th>'
            + '<th id="thDataDeposito">Data Deposito</th>'
            + '<th id="thStato">Stato</th>'
            + '<th id="thTipo">Tipo</th>'
            + '<th id="thParte">Parte</th>'
            + '<th id="thArticolo">Articolo</th>'
            + '<th id="thComma">Comma</th>'
            + '<th id="thLettera">Lettera</th>'
            + '<th id="thTitolo">Titolo</th>'
            + '<th id="thCapo">Capo</th>'
            + '<th id="thMissione"' + (attoVisMisProg ? '' : ' style="display:none;"') + '>Miss.</th>'
            + '<th id="thProgramma"' + (attoVisMisProg ? '' : ' style="display:none;"') + '>Prog.</th>'
            + '<th id="thTitoloM"' + (attoVisMisProg ? '' : ' style="display:none;"') + '>TitoloM</th>'
            + '<th id="thAreaPolitica">Area</th>'
            + '<th id="thFirmatari">Firme</th>'
            + '<th></th>'
            + '</tr></thead><tbody>';

        results.filter(function (em) { return em != null; }).forEach(function (em) {
            html += renderRigaEM(em, ordinamento, attoVisMisProg);
        });

        html += '</tbody></table>';
        if (emSaltati > 0) {
            var elenco = saltatiList.map(function (e) { return escapeText(e); }).join(', ');
            html = '<div class="card-panel red lighten-4 red-text text-darken-4" style="margin: 0 0 8px 0;">'
                + '<i class="material-icons left">warning</i>'
                + '<strong>Attenzione:</strong> ' + emSaltati + ' emendament'
                + (emSaltati === 1 ? 'o non viene visualizzato' : 'i non vengono visualizzati')
                + ' a causa di dati incongruenti (probabile stato non valido a database). '
                + 'Identificativi: <strong>' + elenco + '</strong>. '
                + 'Verifica con la segreteria assemblea.'
                + '</div>' + html;
        }
        container.innerHTML = html;

        // Riattiva i tooltip / dropdown Materialize sugli elementi appena renderizzati.
        if (window.M) {
            M.AutoInit(container);
            $('.dropdown-trigger', container).dropdown({ hover: true });
        }
    }

    function aggiornaComandiGrigliaEM(data) {
        renderTabsOrdinamentoEM(data);
        renderComandiBarraEM(data);
        renderConteggiEM(data);
    }

    // Tab "ORDINE PRESENTAZIONE / ORDINE VOTAZIONE": disposizione orizzontale a tutta larghezza 50/50.
    // Colore in funzione della modalita' client: GRUPPI -> verde, TRATTAZIONE -> blu.
    function renderTabsOrdinamentoEM(data) {
        var container = document.getElementById('tabsOrdinamento');
        if (!container) return;
        var ordinamento = data && data.Ordinamento != null ? data.Ordinamento : 1;
        var presAttiva = ordinamento === 1;
        var votAttiva = ordinamento === 2;

        var clientMode = data && data.Mode != null
            ? data.Mode
            : parseInt(document.getElementById('hdMode').value || '1', 10);
        var coloreAttivo = clientMode === 2 ? '#1565c0' : '#2e7d32';

        var styleTabBase =
            'box-sizing:border-box;float:left;width:50%;text-align:center;padding:12px 0;'
            + 'cursor:pointer;text-transform:uppercase;letter-spacing:0.5px;'
            + 'border-bottom:3px solid ' + coloreAttivo + ';';
        var styleTabAttiva = 'background:' + coloreAttivo + ';color:#fff;font-weight:600;';
        var styleTabInattiva = 'background:#fff;color:#424242;font-weight:500;';

        container.innerHTML =
            '<div class="row" style="margin: 0 0 8px 0;">'
            + '  <div class="col s12" style="padding:0;">'
            + '    <div style="overflow:hidden;">'
            + '      <a onclick="cambiaOrdinamentoEM(1)" '
            + '         style="' + styleTabBase + (presAttiva ? styleTabAttiva : styleTabInattiva) + '">Ordine presentazione</a>'
            + '      <a onclick="cambiaOrdinamentoEM(2)" '
            + '         style="' + styleTabBase + (votAttiva ? styleTabAttiva : styleTabInattiva) + '">Ordine votazione</a>'
            + '    </div>'
            + '  </div>'
            + '</div>';
    }

    // Riga sopra la griglia con: a sinistra "Seleziona tutto" + eventuale filtro firma personale,
    // a destra i pulsanti floating (ordinamento secondario, colonne, stampa, cambio GRID/PREVIEW,
    // testo atto con emendamenti approvati).
    function renderComandiBarraEM(data) {
        var comandi = document.getElementById('comandiGriglia');
        if (!comandi) return;

        var requireMySign = '@(Convert.ToBoolean(HttpUtility.ParseQueryString(Request.Url.Query).Get("require_my_sign")) ? "checked" : "")';
        var isConsigliereGruppi = '@((User.IsInRole(RuoliExt.Consigliere_Regionale) || User.IsInRole(RuoliExt.Assessore_Sottosegretario_Giunta)) && Model.Mode == ClientModeEnum.GRUPPI ? "true" : "false")' === 'true';

        // Icona del bottone di cambio: in GRID si mostra "desktop_windows" (passa a preview),
        // in PREVIEW si mostra "developer_board" (torna alla griglia).
        var viewModeCorrente = data && data.ViewMode != null
            ? data.ViewMode
            : parseInt(document.getElementById('inputFilterView').value || '0', 10);
        var isPreview = viewModeCorrente === @((int)ViewModeEnum.PREVIEW);
        var switchIcon = isPreview ? 'developer_board' : 'desktop_windows';
        var switchTooltip = isPreview ? 'Visualizza in griglia' : 'Visualizza in preview';

        var html = '<div class="row valign-wrapper" style="margin-bottom: 4px;">'
            + '  <div class="col l6 s6 left">'
            + '    <label>'
            + '      <input type="checkbox" id="checkAll" onclick="toggleSelezionaTuttiEM(this);" class="filled-in" />'
            + '      <span>Seleziona tutto</span>'
            + '    </label>';

        if (isConsigliereGruppi) {
            // Stato corrente: la chip invisibile "EMDaFirmare" e' presente fra le chip del pannello
            // quando l'interruttore e' attivo (sincronizzata da filtraEM_RichiestaFirma senza ricaricare).
            var emDaFirmareAttivo = !!document.querySelector(
                '#chips-container .chip.filter-chip[data-filterby="EMDaFirmare"]');
            html += '    <br />'
                + '    <label>'
                + '      <input type="checkbox" id="checkAllMy" onchange="filtraEM_RichiestaFirma(this.checked)"'
                + (emDaFirmareAttivo ? ' checked="checked"' : '') + ' />'
                + '      <span>Visualizza solo gli EM/SUBEM per i quali &#232; richiesta la mia firma</span>'
                + '    </label>';
        }

        // v2026.5.1: pulsanti rotondi di export sopra la griglia (prima di
        // btnOrdinamentoRisultati). Consigliere: solo Excel; segreteria/admin
        // (load_gruppi=true): Word + Excel + Excel Segreteria (UOLA).
        var loadGruppi = @(load_gruppi ? "true" : "false");

        html += '  </div>'
            + '  <div class="col l6 s6 right-align">';

        if (loadGruppi) {
            html += '    <button type="button" class="btn-floating blue white-text tooltipped" '
                + '            onclick="exportEM(@((int)ExportFormatEnum.WORD))" data-tooltip="Esporta Word" data-position="bottom">'
                + '      <i class="material-icons">description</i>'
                + '    </button>'
                + '    <button type="button" class="btn-floating green white-text tooltipped" '
                + '            onclick="exportEM(@((int)ExportFormatEnum.EXCEL))" data-tooltip="Esporta Excel" data-position="bottom">'
                + '      <i class="material-icons">grid_on</i>'
                + '    </button>'
                + '    <button type="button" class="btn-floating pink white-text tooltipped" '
                + '            onclick="exportEM(@((int)ExportFormatEnum.EXCEL_UOLA))" data-tooltip="Esporta Excel Segreteria" data-position="bottom">'
                + '      <i class="material-icons">table_chart</i>'
                + '    </button>';
        } else {
            html += '    <button type="button" class="btn-floating green white-text tooltipped" '
                + '            onclick="exportEM(@((int)ExportFormatEnum.EXCEL))" data-tooltip="Esporta Excel" data-position="bottom">'
                + '      <i class="material-icons">grid_on</i>'
                + '    </button>';
        }

        html += '    <button type="button" id="btnOrdinamentoRisultati" class="btn-floating white black-text tooltipped" '
            + '            data-tooltip="Ordinamento secondario" data-position="bottom">'
            + '      <i class="material-icons">sort_by_alpha</i>'
            + '    </button>'
            + '    <button type="button" class="btn-floating white black-text tooltipped" '
            + '            onclick="ConfirmStampa()" data-tooltip="Stampa" data-position="bottom">'
            + '      <i class="material-icons">print</i>'
            + '    </button>'
            + '    <button type="button" class="btn-floating white black-text tooltipped" '
            + '            onclick="cambiaViewModeEM()" data-tooltip="' + switchTooltip + '" data-position="bottom">'
            + '      <i class="material-icons">' + switchIcon + '</i>'
            + '    </button>'
            + '    <button type="button" class="btn-floating white black-text tooltipped" '
            + '            onclick="viewTestoAtto()" data-tooltip="Testo atto con emendamenti approvati" data-position="bottom">'
            + '      <i class="material-icons">format_align_left</i>'
            + '    </button>'
            + '  </div>'
            + '</div>';

        comandi.innerHTML = html;

        if (window.M) {
            M.AutoInit(comandi);
        }
    }

    // Interruttore "Visualizza solo gli EM/SUBEM per i quali e' richiesta la mia firma":
    // aggiunge/rimuove una chip invisibile EMDaFirmare ai filtri correnti e ricarica la griglia
    // senza ricaricare l'intera pagina. La chip e' invisibile (visible=false) e marcata come
    // fissa lato salva-filtro per non finire nei preferiti utente.
    window.filtraEM_RichiestaFirma = function (enable) {
        var chipsContainer = document.getElementById('chips-container');
        if (!chipsContainer) return;

        if (enable) {
            // Aggiunge la chip EMDaFirmare se non esiste
            var giaPresente = chipsContainer.querySelector('.chip.filter-chip[data-filterby="EMDaFirmare"]');
            if (!giaPresente && typeof addChipIfNotExistsEM === 'function') {
                addChipIfNotExistsEM('EMDaFirmare', 'EM da firmare', 'true', '', '', false, false);
            }
        } else {
            // Rimuove la chip EMDaFirmare se esiste
            var existing = chipsContainer.querySelector('.chip.filter-chip[data-filterby="EMDaFirmare"]');
            if (existing) {
                existing.remove();
                if (typeof salvaFiltriEM === 'function') salvaFiltriEM();
            }
        }

        if (typeof inviaDatiChipsEM === 'function') inviaDatiChipsEM(1);
    };

    // Cambio della modalita' di visualizzazione (GRID <-> PREVIEW) con nuovo caricamento della griglia.
    window.cambiaViewModeEM = function () {
        var hidden = document.getElementById('inputFilterView');
        if (!hidden) return;
        var current = parseInt(hidden.value || '0', 10);
        var nuovo = current === @((int)ViewModeEnum.GRID) ? @((int)ViewModeEnum.PREVIEW) : @((int)ViewModeEnum.GRID);
        hidden.value = nuovo;
        try { localStorage.setItem('viewModeEm', nuovo); } catch (e) { /* ignore */ }
        if (typeof inviaDatiChipsEM === 'function') inviaDatiChipsEM(1);
    };

    // Footer della griglia con riepilogo conteggi per gruppo politico e per area politica,
    // popolato dal backend nei campi ConteggiGruppi / ConteggiAreePolitiche.
    // Layout allineato a quello del riepilogo Razor di produzione: due tabelle compatte
    // con riga totale evidenziata; le righe a zero restano visibili (informazione attesa).
    function renderConteggiEM(data) {
        var container = document.getElementById('conteggiContainer');
        if (!container) return;

        var gruppi = data && Array.isArray(data.ConteggiGruppi) ? data.ConteggiGruppi : [];
        var aree = data && Array.isArray(data.ConteggiAreePolitiche) ? data.ConteggiAreePolitiche : [];
        if (gruppi.length === 0 && aree.length === 0) {
            container.innerHTML = '';
            return;
        }

        // Le view SQL di backend espongono il conteggio sul campo num_em (View_Conteggi_EM_Gruppi_Politici
        // e View_Conteggi_EM_Area_Politica). Le forme alternative Totale/totale coprono eventuali nomi futuri.
        function valoreTotale(item) {
            if (!item) return 0;
            var v = item.num_em != null ? item.num_em
                : (item.Totale != null ? item.Totale
                    : (item.totale != null ? item.totale : 0));
            return parseInt(v, 10) || 0;
        }

        function buildTabella(righe, rigaTotale) {
            var html = '<table class="striped" style="margin:0;">';
            righe.forEach(function (r) {
                html += '<tr>'
                    + '  <td style="padding:10px 16px;">' + escapeText(r.label) + '</td>'
                    + '  <td class="right-align" style="padding:10px 16px;width:80px;">' + r.valore + '</td>'
                    + '</tr>';
            });
            if (rigaTotale) {
                html += '<tr style="font-weight:600;">'
                    + '  <td style="padding:10px 16px;">' + escapeText(rigaTotale.label) + '</td>'
                    + '  <td class="right-align" style="padding:10px 16px;width:80px;">' + rigaTotale.valore + '</td>'
                    + '</tr>';
            }
            html += '</table>';
            return html;
        }

        var html = '';
        if (gruppi.length > 0) {
            var righeGruppi = [];
            var totale = 0;
            gruppi.forEach(function (g) {
                var label = g.nome_gruppo || g.codice_gruppo || '';
                var n = valoreTotale(g);
                totale += n;
                righeGruppi.push({ label: label, valore: n });
            });
            html += '<div class="card-panel" style="padding:0;margin:16px 0 8px 0;">'
                + buildTabella(righeGruppi, { label: 'Totale', valore: totale })
                + '</div>';
        }
        if (aree.length > 0) {
            // La view backend espone "AreaPolitica" come stringa (Maggioranza/Minoranza/...);
            // come ripiego accettiamo un'eventuale corrispondenza numerica passata dal repository.
            var righeAree = aree.map(function (a) {
                var label = a.AreaPolitica;
                if (typeof label === 'number') {
                    label = label === 1 ? 'Maggioranza' : label === 2 ? 'Minoranza' : ('Area ' + label);
                } else if (!label && a.area_politica) {
                    label = a.area_politica;
                }
                return { label: label || '', valore: valoreTotale(a) };
            });
            html += '<div class="card-panel" style="padding:0;margin:8px 0 16px 0;">'
                + buildTabella(righeAree, null)
                + '</div>';
        }
        container.innerHTML = html;
    }

    // Cambia l'ordinamento principale (Presentazione/Votazione) e ricarica i risultati.
    window.cambiaOrdinamentoEM = function (nuovoOrdinamento) {
        var hidden = document.getElementById('inputFilterOrdine');
        if (hidden) hidden.value = nuovoOrdinamento;
        if (typeof inviaDatiChipsEM === 'function') inviaDatiChipsEM(1);
    };

    // Barra di paginazione: il rendering e' centralizzato in renderPaginazione (site.js),
    // condiviso con le griglie DASI. Qui restano solo le callback specifiche di PEM.
    window.creaPaginazioneEM = function (data) {
        renderPaginazione({
            data: data,
            onPage: function (page) { paginazioneEM(page); },
            onSize: function (size) { paginazioneSizeEM(size); }
        });
    };

    window.paginazioneEM = function (page) {
        if (typeof inviaDatiChipsEM === 'function') inviaDatiChipsEM(page);
    };

    window.paginazioneSizeEM = function (size) {
        var hidden = document.getElementById('inputFilterSize');
        if (hidden) hidden.value = size;
        try { localStorage.setItem('pagingEm.size', size); } catch (e) { /* ignore */ }
        if (typeof inviaDatiChipsEM === 'function') inviaDatiChipsEM(1);
    };

    // Vista a card per consigliere/assessore in modalita' GRID.
    // Replica fedele di _GridView_RiepilogoEM.cshtml (versione Razor originale): per ogni EM una
    // card con titolo "stato", numero EM in grande, metadati parte, info creatore/depositante,
    // chip proponente + chip "+N firme", e barra azioni in basso con tags/stampa/visualizza.
    function renderCardConsigliereListaEM(results, modeCorrente, emSaltati, saltatiList) {
        var html = '';
        if (emSaltati > 0) {
            var elenco = saltatiList.map(function (e) { return escapeText(e); }).join(', ');
            html += '<div class="card-panel red lighten-4 red-text text-darken-4" style="margin: 0 0 8px 0;">'
                + '<i class="material-icons left">warning</i>'
                + '<strong>Attenzione:</strong> ' + emSaltati + ' emendament'
                + (emSaltati === 1 ? 'o non viene visualizzato' : 'i non vengono visualizzati')
                + ' (dati incongruenti). Identificativi: <strong>' + elenco + '</strong>.'
                + '</div>';
        }
        results.filter(function (em) { return em != null; }).forEach(function (em) {
            html += renderCardConsigliereEM(em, modeCorrente);
        });
        if (html === '') {
            html = '<div class="card-panel panel-warning center">Non ci sono emendamenti al momento</div>';
        }
        return html;
    }

    function renderCardConsigliereEM(em, modeCorrente) {
        var statoCss = em.STATI_EM && em.STATI_EM.CssClass ? em.STATI_EM.CssClass : '';
        var statoLabel = em.STATI_EM && em.STATI_EM.Stato ? escapeText(em.STATI_EM.Stato) : '';
        var metaDati = metaDatiLabelHtmlEM(em);
        var proponenteName = em.PersonaProponente && em.PersonaProponente.DisplayName
            ? em.PersonaProponente.DisplayName : '';
        var codiceGruppo = em.gruppi_politici && em.gruppi_politici.codice_gruppo
            ? em.gruppi_politici.codice_gruppo : '';
        var isTrattazione = modeCorrente === @((int)ClientModeEnum.TRATTAZIONE);
        var proponenteFooter = proponenteName + (isTrattazione && codiceGruppo ? ' (' + codiceGruppo + ')' : '');

        // Chip principale stato (header card)
        var chipStato = '<div id="iconEMDepositabile_' + em.UIDEM + '" class="chip ' + statoCss
            + '" style="width: 100%">';
        if (em.Depositabile) {
            chipStato += '<i class="icon material-icons left tooltipped" data-tooltip="Depositabile" style="margin-top: -2px">gavel</i>';
        }
        chipStato += statoLabel;
        if (em.PresentatoOltreITermini) {
            chipStato += '<i class="icon material-icons red-text right tooltipped" data-position="bottom" '
                + 'data-tooltip="Presentato oltre i termini" style="margin-top: -3px">warning</i>';
        }
        if (em.NOTE_Griglia) {
            chipStato += '<i class="icon material-icons right tooltipped" data-tooltip="'
                + escapeAttr(em.NOTE_Griglia) + '" style="margin-top: -2px">chat</i>';
        }
        chipStato += '</div>';

        // Sezione creatore/depositante in funzione dello stato
        var infoCreazioneDeposito = '';
        var IDStato = em.IDStato != null ? em.IDStato : 0;
        if (IDStato <= 0) {
            var creatore = em.PersonaCreazione && em.PersonaCreazione.DisplayName
                ? em.PersonaCreazione.DisplayName : '';
            infoCreazioneDeposito = '<h6 style="font-size: small; font-weight: bold; padding-top: 10px">'
                + 'Bozza predisposta da: <span id="lblCreatore_' + em.UIDEM + '">'
                + escapeText(creatore) + '</span></h6>';
        } else if (em.DataDeposito) {
            var depositante = em.PersonaDeposito && em.PersonaDeposito.DisplayName
                ? em.PersonaDeposito.DisplayName : '';
            infoCreazioneDeposito = '<h6 style="font-size: small; font-weight: bold; padding-top: 10px">'
                + 'Depositato da <span id="lblPersonaDeposito_' + em.UIDEM + '">'
                + escapeText(depositante) + '</span> il '
                + escapeText(em.DataDeposito) + '</h6>';
        }

        // Chip proponente (solo per EM depositati)
        var chipProponente = '';
        if (IDStato >= 1 /* Depositato */) {
            chipProponente = '<div class="chip deep-purple lighten-4 center activator" '
                + 'onclick="RevealFirmatari(\'' + em.UIDEM + '\')" '
                + 'style="margin-bottom: 0; margin-top: 10px; min-width: unset;">';
            if (em.Firma_da_ufficio && em.Firma_ufficio) {
                chipProponente += '<b>' + escapeText(em.Firma_ufficio.FirmaCert || '') + '</b>';
            } else {
                chipProponente += '<span class="hide-on-med-and-down">Firmato dal proponente:</span>'
                    + '<span class="hide-on-large-only">Proponente:</span> ';
                if (em.Firmato_Dal_Proponente) {
                    chipProponente += escapeText(proponenteName);
                } else {
                    chipProponente += '<span style="color: grey; text-decoration: line-through;">'
                        + escapeText(proponenteName) + '</span>';
                }
                if (em.Proponente_Relatore) chipProponente += ' <b>(RELATORE)</b>';
            }
            if (em.ConteggioFirme > 1) {
                chipProponente += ' <span class="chip hoverable grey darken-1 white-text activator" '
                    + 'style="font-size: small; margin-right: -12px; min-width: unset; margin-bottom: unset !important;">'
                    + '+ ' + (em.ConteggioFirme - 1) + '</span>';
            }
            chipProponente += '</div>';
        }

        // Sezione firmatari/destinatari (solo bozza/non depositato)
        var firmatariBlock = '';
        if (IDStato < 1 && em.Firmatari) {
            firmatariBlock += '<div class="row"><div class="col l12 s12">'
                + '<div id="pnlAzioniEM_' + em.UIDEM + '">'
                + '<h6><b>Firmatari</b></h6><hr/>'
                + em.Firmatari
                + '</div></div></div>';
        }
        if (IDStato < 1 && em.Destinatari) {
            firmatariBlock += '<div class="row"><div class="col l12 s12">'
                + '<h6><b>Invitati</b></h6><hr/>'
                + em.Destinatari
                + '</div></div>';
        }

        // Pannello tag (dentro il card-reveal): replica del ramo Razor che deserializza itemEM.Tags.
        // em.Tags arriva dal backend come stringa JSON (default "[]"), quindi il parse e' sempre sicuro.
        var tagsHtml = '';
        try {
            var tagsArr = em.Tags ? JSON.parse(em.Tags) : [];
            if (tagsArr && tagsArr.length) {
                tagsHtml = '<ul>';
                tagsArr.forEach(function (t) { tagsHtml += '<li>#' + escapeText(t.tag) + '</li>'; });
                tagsHtml += '</ul>';
            }
        } catch (e) { tagsHtml = ''; }

        // Card-reveal: pannello scorrevole con firmatari (caricati via AJAX da RevealFirmatari) e tag.
        // DEVE essere figlio diretto di .card: Materialize aggancia il reveal con un handler delegato
        // su document che agisce solo se la card ha un figlio .card-reveal (cfr. materialize.js).
        // Replica fedele di _GridView_RiepilogoEM.cshtml; senza questo blocco il chip proponente non
        // apre nulla e #panelRevealFirmatari_<uidem> non esiste (issue #1613).
        var cardReveal = '<div class="card-reveal" id="reveal_' + em.UIDEM + '" style="padding-bottom: 65px">'
            + '<span class="card-title grey-text text-darken-4 center">'
            + '<span id="titleReveal_' + em.UIDEM + '">Firmatari</span> <i class="material-icons right">close</i>'
            + '</span>'
            + '<div id="panelRevealFirmatari_' + em.UIDEM + '" style="display: none;">'
            + '<div id="dataItems" class="collection" style="height: 100%; overflow: auto;">'
            + '<div class="progress"><div class="indeterminate"></div></div>'
            + '</div></div>'
            + '<div id="panelRevealTags_' + em.UIDEM + '" style="display: none;">' + tagsHtml + '</div>'
            + '</div>';

        return '<div class="col l12 m12 s12">'
            + '<div class="card sticky-action hoverable" style="min-height: 300px">'
            + '  <div class="card-content">'
            + '    <div class="card-title">'
            + '      <div class="row" style="margin: unset !important;">'
            + '        <div class="col l1 s12" style="margin-top: 10px">'
            + '          <label><input type="checkbox" id="chk_EM_' + em.UIDEM
            + '" onclick="AbilitaComandiMassivi(\'' + em.UIDEM + '\');"/><span></span></label>'
            + '        </div>'
            + '        <div class="col l11 s12 center">' + chipStato + '</div>'
            + '      </div>'
            + '      <div class="row"><div class="col l12 s12 center">'
            + '        <h4 style="margin-top: 7px"><b>'
            + (em.EffettiFinanziari === 1 ? '&euro; ' : '')
            + escapeText(em.N_EM || '') + '</b></h4>'
            + '        <h6>' + metaDati + '</h6>'
            + infoCreazioneDeposito
            + chipProponente
            + '      </div></div>'
            + firmatariBlock
            + '    </div>'
            + '  </div>'
            + '  <div class="card-action grey lighten-4">'
            + '    <div class="row" style="margin: 0 !important">'
            + '      <div class="col s6 left">'
            + '        <label class="hide-on-med-and-down" style="font-size: small !important">Proponente: </label>'
            + '        <h6 id="lblProponente_' + em.UIDEM + '"><b>' + escapeText(proponenteFooter) + '</b></h6>'
            + '      </div>'
            + '      <div class="col s6 right-align">'
            + '        <button type="button" class="btn-floating white black-text tooltipped activator" '
            + '                data-tooltip="Visualizza tags" onclick="RevealTags(\'' + em.UIDEM + '\')">'
            + '          <i class="material-icons">filter_frames</i>'
            + '        </button>'
            + '        <a class="btn-floating white black-text tooltipped" data-tooltip="Stampa" '
            + '           target="_blank" href="' + baseUrl + '/emendamenti/file?id=' + em.UIDEM + '">'
            + '          <i class="material-icons">print</i>'
            + '        </a>'
            + '        <button type="button" class="btn-floating white black-text tooltipped" '
            + '                data-tooltip="Visualizza EM" '
            + '                onclick="goIntoOtherTab(\'' + baseUrl + '/emendamenti/view/' + em.UIDEM + '\')">'
            + '          <i class="material-icons">chevron_right</i>'
            + '        </button>'
            + '      </div>'
            + '    </div>'
            + '  </div>'
            + cardReveal
            + '</div>'
            + '</div>';
    }

    // Replica lato browser di Common.Utility.MetaDatiEM_LabelHtml: produce "Emendamento <tipo><br><parte>".
    // Le proprieta' lette dal DTO (TIPI_EM, PARTI_TESTO, ARTICOLI, COMMI, LETTERE, NTitolo/NCapo,
    // NMissione/NProgramma/NTitoloB, NLettera) sono popolate dal backend nel GetEM_DTO.
    function metaDatiLabelHtmlEM(em) {
        var tipo = em.TIPI_EM && em.TIPI_EM.Tipo_EM ? em.TIPI_EM.Tipo_EM : '';
        var parte = '';
        var idParte = em.PARTI_TESTO ? em.PARTI_TESTO.IDParte : null;
        switch (idParte) {
            case 1: // Titolo_PDL
                parte = em.PARTI_TESTO ? (em.PARTI_TESTO.Parte || '') : '';
                break;
            case 2: // Titolo
                parte = 'Titolo: ' + (em.NTitolo || '');
                break;
            case 3: // Capo
                parte = 'Capo: ' + (em.NCapo || '');
                break;
            case 4: { // Articolo
                var art = em.ARTICOLI && em.ARTICOLI.Articolo ? 'Articolo: ' + em.ARTICOLI.Articolo : '';
                var com = em.COMMI && em.COMMI.Comma ? ', Comma: ' + em.COMMI.Comma : '';
                var let = em.NLettera
                    ? ', Lettera: ' + em.NLettera
                    : (em.LETTERE && em.LETTERE.Lettera ? ', Lettera: ' + em.LETTERE.Lettera : '');
                parte = art + com + let;
                break;
            }
            case 5: // Missione
                parte = 'Missione: ' + (em.NMissione || '')
                    + ' Programma: ' + (em.NProgramma || '')
                    + ' titolo: ' + (em.NTitoloB || '');
                break;
            case 6: // Allegato/Tabella
                parte = 'Allegato/Tabella';
                break;
            default:
                parte = '';
        }
        return 'Emendamento ' + escapeText(tipo) + '<br>' + escapeText(parte);
    }

    // Issue #1615: BodyEM e' un frammento HTML "autoportante" (vista standalone del singolo
    // emendamento): include i <link> a Material Icons, materialize.min.css e site.css. Iniettato
    // tal quale nella pagina viva, e per 20 EM a pagina, quei fogli di stile vengono ri-applicati
    // in coda alla cascata globale e scavalcano le personalizzazioni del portale: le chip tornano
    // al grigio Materialize e le icone dei btn-floating bianchi tornano bianche (invisibili su
    // sfondo bianco). I <link> a CDN non in whitelist generano anche errori CSP, uno per EM.
    // Qui ripuliamo il frammento dai tag di livello documento: la pagina ospite ha gia' caricato
    // materialize + site.css, quindi il markup dell'emendamento resta stilizzato correttamente.
    function sanitizePreviewBodyEM(rawHtml) {
        if (!rawHtml) return '';
        try {
            var doc = new DOMParser().parseFromString(rawHtml, 'text/html');
            doc.querySelectorAll('link, style, script, meta, base, title')
                .forEach(function (n) { n.remove(); });
            return doc.body ? doc.body.innerHTML : rawHtml;
        } catch (e) {
            // Fallback se DOMParser non e' disponibile: rimuove almeno i tag che fanno il danno.
            return rawHtml
                .replace(/<link\b[^>]*>/gi, '')
                .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, '')
                .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '');
        }
    }

    // Rendering "preview" (lista card) attivato quando ViewMode == PREVIEW.
    // Pattern allineato al riepilogo DASI (_FiltriRapidiDASIPanel.cshtml > createCard):
    // una card per emendamento con i pulsanti in alto a destra e, sotto, il BodyEM
    // formattato in HTML che il backend popola nello stesso ramo del flusso EmendamentiLogic.
    function renderPreviewListaEM(results, emSaltati, saltatiList) {
        var html = '';
        if (emSaltati > 0) {
            var elenco = saltatiList.map(function (e) { return escapeText(e); }).join(', ');
            html += '<div class="card-panel red lighten-4 red-text text-darken-4" style="margin: 0 0 8px 0;">'
                + '<i class="material-icons left">warning</i>'
                + '<strong>Attenzione:</strong> ' + emSaltati + ' emendament'
                + (emSaltati === 1 ? 'o non viene visualizzato' : 'i non vengono visualizzati')
                + ' (dati incongruenti). Identificativi: <strong>' + elenco + '</strong>.'
                + '</div>';
        }
        results.filter(function (em) { return em != null; }).forEach(function (em) {
            var bodyEm = sanitizePreviewBodyEM(em.BodyEM) || '<em class="grey-text">Anteprima non disponibile</em>';

            html += '<div class="row card" style="margin-bottom: 12px;">'
                + '  <div class="col s12 right-align" style="position:absolute;margin-top:10px;z-index:1;">'
                + '    <label style="margin-right:12px;">'
                + '      <input type="checkbox" id="chk_EM_' + em.UIDEM
                + '" onclick="AbilitaComandiMassivi(\'' + em.UIDEM + '\');"/><span></span>'
                + '    </label>'
                + '    <a class="btn-flat black-text tooltipped" style="margin:2px" '
                + '       data-position="bottom" data-tooltip="Stampa" '
                + '       href="' + baseUrl + '/emendamenti/file?id=' + em.UIDEM + '" target="_blank">'
                + '      <i class="material-icons">print</i>'
                + '    </a>'
                + '    <button type="button" class="btn-flat blue-text tooltipped" '
                + '            onclick="openMetaDati(\'' + em.UIDEM + '\')" style="margin:2px" '
                + '            data-position="bottom" data-tooltip="Modifica meta-dati">'
                + '      <i class="material-icons">edit</i>'
                + '    </button>'
                + '    <button type="button" class="btn-flat green-text tooltipped" '
                + '            onclick="goIntoOtherTab(\'' + baseUrl + '/emendamenti/view/' + em.UIDEM + '\')" '
                + '            style="margin:2px" data-position="bottom" data-tooltip="Visualizza emendamento">'
                + '      <i class="material-icons">chevron_right</i>'
                + '    </button>'
                + '  </div>'
                + '  <div class="col s12 card-content">'
                + bodyEm
                + '  </div>'
                + '</div>';
        });
        if (html === '') {
            html = '<div class="card-panel panel-warning center">Nessun emendamento da visualizzare</div>';
        }
        return html;
    }

    function renderRigaEM(em, ordinamento, attoVisMisProg) {
        if (!em) return '';
        var bg = em.Colore ? ('background-color: ' + em.Colore) : '';

        var noteHtml = '';
        if (em.NOTE_Griglia) {
            noteHtml += '<i class="icon material-icons tooltipped" data-tooltip="'
                + escapeAttr(em.NOTE_Griglia) + '">chat</i>';
        }
        if (em.NOTE_EM) {
            if (noteHtml) noteHtml += '<br />';
            noteHtml += '<i class="icon material-icons tooltipped red-text" data-tooltip="'
                + escapeAttr(em.NOTE_EM) + '">comment</i>';
        }

        var ordineNum;
        if (ordinamento === 2) ordineNum = em.OrdineVotazione;
        else if (ordinamento === 3) ordineNum = em.OrdinePresentazione;
        else ordineNum = em.OrdinePresentazione;
        if (ordineNum == null) ordineNum = '';

        var emText = (em.EffettiFinanziari ? '<i class="material-icons" style="font-size: medium;">euro_symbol</i> ' : '')
            + '<span class="black-text">' + escapeText(em.N_EM || '') + '</span>';

        var dataDeposito = em.DataDeposito || '';
        if (dataDeposito && em.PresentatoOltreITermini) {
            dataDeposito += ' <i class="material-icons red-text tooltipped" data-position="bottom" '
                + 'data-tooltip="Presentato oltre i termini">warning</i>';
        }

        var statoCss = em.STATI_EM && em.STATI_EM.CssClass ? em.STATI_EM.CssClass : '';
        var statoLabel = em.STATI_EM && em.STATI_EM.Stato ? escapeText(em.STATI_EM.Stato) : '';
        // Codici StatiEnum: Depositato=1, Approvato=2, Non_Approvato=3, Ritirato=4,
        // Decaduto=5, Inammissibile=6, Approvato_Con_Modifiche=7.
        var statoHtml = '<label class="' + statoCss + 'T" style="border:none!important">'
            + statoLabel + '</label>'
            + ' <a class="dropdown-trigger blue-text" href="#" data-target="dropdown_' + em.UIDEM + '">'
            + '<i class="icon material-icons">refresh</i></a>'
            + '<ul id="dropdown_' + em.UIDEM + '" class="dropdown-content" style="max-width: 300px">'
            + '  <li><a class="depositatoT" onclick="CambioStato(\'' + em.UIDEM + '\', 1)"><i class="material-icons">lock</i> Depositato</a></li>'
            + '  <li><a class="approvatoT" onclick="CambioStato(\'' + em.UIDEM + '\', 2)"><i class="material-icons">check</i> Approva</a></li>'
            + '  <li><a class="approvatomodT" onclick="CambioStato(\'' + em.UIDEM + '\', 7)"><i class="material-icons">check</i> Approva con modifiche</a></li>'
            + '  <li><a class="NOapprovatoT" onclick="CambioStato(\'' + em.UIDEM + '\', 3)"><i class="material-icons">close</i> Non approva</a></li>'
            + '  <li><a class="inammissibileT" onclick="CambioStato(\'' + em.UIDEM + '\', 6)"><i class="material-icons">not_interested</i> Inammissibile</a></li>'
            + '  <li><a class="decadutoT" onclick="CambioStato(\'' + em.UIDEM + '\', 5)"><i class="material-icons">report</i> Decaduto</a></li>'
            + '  <li><a class="ritiratoT" onclick="CambioStato(\'' + em.UIDEM + '\', 4)"><i class="material-icons">delete</i> Ritira</a></li>'
            + '</ul>';

        var tipo = em.TIPI_EM ? (em.TIPI_EM.Tipo_EM || '') : '';
        var parte = em.PARTI_TESTO ? (em.PARTI_TESTO.Parte || '') : '';
        var articolo = em.ARTICOLI ? (em.ARTICOLI.Articolo || '') : '';
        var comma = em.COMMI ? (em.COMMI.Comma || '') : '';
        var lettera = (em.UIDLettera && em.LETTERE) ? em.LETTERE.Lettera : (em.NLettera || '');
        var area = '';
        if (em.AreaPolitica != null) {
            // Enum AreaPoliticaIntEnum sul backend: 1 = Maggioranza, 2 = Minoranza (riferimento DASI).
            area = em.AreaPolitica === 1 ? 'Maggioranza'
                : em.AreaPolitica === 2 ? 'Minoranza'
                : String(em.AreaPolitica);
        }

        var firmeHtml = renderFirmatariEM(em);

        var hideMP = attoVisMisProg ? '' : ' style="display:none;"';

        var checkboxCell = '<td style="padding-left: 15px">'
            + '<label>'
            + '<input type="checkbox" id="chk_EM_' + em.UIDEM
            + '" onclick="AbilitaComandiMassivi(\'' + em.UIDEM + '\');" class="filled-in" />'
            + '<span></span>'
            + '</label></td>';

        var comandiCell = '<td class="center" style="width: 5%">'
            + '  <a class="btn-floating white black-text tooltipped" style="margin: 2px" data-position="bottom" data-tooltip="Stampa" '
            + '     href="' + baseUrl + '/emendamenti/file?id=' + em.UIDEM + '" target="_blank">'
            + '    <i class="material-icons">print</i>'
            + '  </a>'
            + '  <button type="button" class="btn-floating white black-text tooltipped" '
            + '     onclick="openMetaDati(\'' + em.UIDEM + '\')" style="margin: 2px" data-position="bottom" data-tooltip="Modifica meta-dati">'
            + '    <i class="material-icons">edit</i>'
            + '  </button>'
            + '  <button type="button" class="btn-floating white black-text tooltipped" '
            + '     onclick="goIntoOtherTab(\'' + baseUrl + '/emendamenti/view/' + em.UIDEM + '\')" '
            + '     style="margin: 2px" data-position="bottom" data-tooltip="Visualizza emendamento">'
            + '    <i class="material-icons">chevron_right</i>'
            + '  </button>'
            + '</td>';

        return '<tr>'
            + '<td style="' + bg + '" width="10"></td>'
            + checkboxCell
            + '<td>' + noteHtml + '</td>'
            + '<td>' + ordineNum + '</td>'
            + '<td id="tdNumeroEM_' + em.UIDEM + '">' + emText + '</td>'
            + '<td class="center" id="tdDataDeposito_' + em.UIDEM + '">' + dataDeposito + '</td>'
            + '<td id="tdStato_' + em.UIDEM + '">' + statoHtml + '</td>'
            + '<td id="tdTipo_' + em.UIDEM + '">' + escapeText(tipo) + '</td>'
            + '<td id="tdParte_' + em.UIDEM + '">' + escapeText(parte) + '</td>'
            + '<td id="tdArticolo_' + em.UIDEM + '">' + escapeText(articolo) + '</td>'
            + '<td id="tdComma_' + em.UIDEM + '">' + escapeText(comma) + '</td>'
            + '<td id="tdLettera_' + em.UIDEM + '">' + escapeText(lettera) + '</td>'
            + '<td id="tdTitolo_' + em.UIDEM + '">' + escapeText(em.NTitolo || '') + '</td>'
            + '<td id="tdCapo_' + em.UIDEM + '">' + escapeText(em.NCapo || '') + '</td>'
            + '<td id="tdMissione_' + em.UIDEM + '"' + hideMP + '>' + (em.NMissione != null ? em.NMissione : '') + '</td>'
            + '<td id="tdProgramma_' + em.UIDEM + '"' + hideMP + '>' + (em.NProgramma != null ? em.NProgramma : '') + '</td>'
            + '<td id="tdTitoloM_' + em.UIDEM + '"' + hideMP + '>' + (em.NTitoloB != null ? em.NTitoloB : '') + '</td>'
            + '<td id="tdAreaPolitica_' + em.UIDEM + '">' + area + '</td>'
            + '<td id="tdFirmatari_' + em.UIDEM + '">' + firmeHtml + '</td>'
            + comandiCell
            + '</tr>';
    }

    function renderFirmatariEM(em) {
        if (em.Firma_da_ufficio) {
            var certText = em.Firma_ufficio ? (em.Firma_ufficio.FirmaCert || '') : '';
            return '<b class="tooltipped" data-tooltip="' + escapeAttr(certText) + '">Firmato d\'ufficio</b>';
        }

        var codiceGruppo = '';
        if (em.id_gruppo > 10000) codiceGruppo = 'GIUNTA';
        else if (em.gruppi_politici && em.gruppi_politici.codice_gruppo) codiceGruppo = em.gruppi_politici.codice_gruppo;

        var nomeProponente = (em.PersonaProponente && em.PersonaProponente.DisplayName) || '';
        var proponente = nomeProponente + (codiceGruppo ? ' (' + codiceGruppo + ')' : '');

        var html = '';
        if (!em.Firmato_Dal_Proponente) {
            html = '<span class="grey-text tooltipped" data-tooltip="Il Proponente non ha ancora firmato">'
                + escapeText(proponente) + '</span>';
        } else {
            if (em.Proponente_Relatore) {
                html = '<b>RELATORE</b><br />';
            }
            html += escapeText(proponente);
        }

        if (em.ConteggioFirme > 1) {
            html += '<br /><a class="chip tooltipped blue darken-3 white-text" data-position="left" data-tooltip="'
                + escapeAttr(em.Firme || '') + '" style="min-width: unset">+ '
                + (em.ConteggioFirme - 1) + ' <i class="icon material-icons right" style="margin-left: unset">group</i></a>';
        }
        return html;
    }

    function escapeText(s) {
        if (s == null) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function escapeAttr(s) {
        return escapeText(s).replace(/"/g, '&quot;');
    }

    // Gestione del "Seleziona tutto" della griglia: aggiorna lo stato globale e i singoli checkbox
    // di riga, poi lascia che il site.js riconcili lo stato dei comandi massivi.
    window.toggleSelezionaTuttiEM = function (ctrl) {
        var checked = !!(ctrl && ctrl.checked);
        if (typeof setSelezionaTutti === 'function') setSelezionaTutti(checked);
        if (typeof setListaEmendamenti === 'function') setListaEmendamenti([]);
        document.querySelectorAll('input[id^="chk_EM_"]').forEach(function (el) {
            el.checked = checked;
        });
        if (typeof AbilitaComandiMassivi === 'function') AbilitaComandiMassivi(null);
    };

    // Variante "solo identificatori" usata dai comandi massivi quando l'utente vuole agire sull'intero
    // risultato corrente (Tutti=true). Restituisce una Promise<List<Guid>>.
    window.inviaDatiChipsEMSoloIds = async function () {
        var request = window.buildFilterRequestEM();
        var response = await fetch(baseUrl + '/emendamenti/riepilogoEMSoloIds', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json; charset=utf-8' },
            body: JSON.stringify(request)
        });
        if (!response.ok) throw new Error('Errore di rete (' + response.status + ')');
        return await response.json();
    };

    // API helpers: riuso funzioni esistenti da FiltriManager.js
    // GetArticoli(attoUId), GetCommi(articoloUId, expanded), GetLettere(commaUId), GetProponenti(idLegislatura)

    // Funzioni filtra/reset per compatibilita'
    function filtra(page) {
        if (page) { $('#inputFilterPage').val(page); }
        inviaDatiChipsEM(page);
    }

    function filtra_Paginazione(size) {
        $('#inputFilterPage').val(1);
        $('#inputFilterSize').val(size);
        inviaDatiChipsEM(1);
    }

    function filtra_View(view) {
        $('#inputFilterView').val(view);
        inviaDatiChipsEM();
    }

    function filtra_Ordinamento(ordine) {
        $('#inputFilterPage').val(1);
        $('#inputFilterOrdine').val(ordine);
        inviaDatiChipsEM(1);
    }

    async function reset() {
        localStorage.removeItem('filtriChipsEM');
        chipsKeysEM = {};
        ripristinaFiltriEM(); // Ripristina solo i default
        inviaDatiChipsEM(1);
    }

    function ShowHideTableColumn(ctrl, enable) {
        if (enable) {
            $('#th' + ctrl).show();
            $('td[id^="td' + ctrl + '"]').show();
        } else {
            $('#th' + ctrl).hide();
            $('td[id^="td' + ctrl + '"]').hide();
        }
    }
</script>

