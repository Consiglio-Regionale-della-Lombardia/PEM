@using PortaleRegione.Client.Helpers
@using PortaleRegione.DTO.Domain
@using PortaleRegione.DTO.Enum
@using Utility = PortaleRegione.Common.Utility
@model PortaleRegione.DTO.Response.EmendamentiViewModel

@{
    bool load_gruppi = User.IsInRole(RuoliExt.Amministratore_PEM)
                       || User.IsInRole(RuoliExt.Segreteria_Assemblea);
}

<div class="row">
    <div class="input-field col s12">
        <i class="material-icons prefix">search</i>
        <input type="text" id="autocomplete-input" class="autocomplete">
        <label for="autocomplete-input">Ricerca filtri disponibili</label>
    </div>
</div>
<div class="row">
    <div class="col l7 m12 s12 left-align" style="padding-top: 10px;">
        <div id="chips-container"></div>
        <div id="chips-container-sorting"></div>
    </div>
    <div class="col l5 m12 s12 right-align">
        <button id="btnFiltroConfig" class="btn-flat blue-text">Salva filtro</button>
        <button id="btnReportConfig" class="btn-flat pink-text">Genera report</button>
        <div class="row">
            <div class="col s12">
                <div id="chips-container-selected-report"></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col s12">
        <div id="chips-container-groups"></div>
    </div>
</div>

@* Form nascosto per bridge verso il backend esistente *@
@using (Html.BeginForm("Filtri_RiepilogoEM", "Emendamenti", FormMethod.Post, new { id = "formFiltraEM" }))
{
    @Html.AntiForgeryToken()

    <input id="inputFilterReset" type="hidden" name="reset" value="0" />
    <input id="inputFilterView" type="hidden" name="view" value="@Model.ViewMode" />
    <input id="inputFilterPage" type="hidden" name="page" value="@Model.Data.Paging.Page" />
    <input id="inputFilterSize" type="hidden" name="size" value="@Model.Data.Paging.Limit" />
    <input type="hidden" id="hdMode" name="mode" value="@((int)Model.Mode)" />
    <input type="hidden" id="inputFilterOrdine" name="ordine" value="@((int)Model.Ordinamento)" />
    <input type="hidden" id="inputFiltroAtto" name="atto" value="@Model.Atto.UIDAtto" />
    <input type="hidden" id="inputFiltroTags" name="tags" value="" />

    @* Campi nascosti per bridge filtri chip -> form POST *@
    <input type="hidden" id="bridge_filtro_text1" name="filtro_text1" value="" />
    <input type="hidden" id="bridge_filtro_text_connector" name="filtro_text_connector" value="" />
    <input type="hidden" id="bridge_filtro_text2" name="filtro_text2" value="" />
    <input type="hidden" id="bridge_filtro_n_em" name="filtro_n_em" value="" />
    <input type="hidden" id="bridge_filtro_subem" name="filtro_subem" value="" />
    <input type="hidden" id="bridge_filtro_tipo" name="filtro_tipo" value="" />
    <input type="hidden" id="bridge_filtro_stato" name="filtro_stato" value="" />
    <input type="hidden" id="bridge_filtro_parte" name="filtro_parte" value="" />
    <input type="hidden" id="bridge_filtro_parte_articolo" name="filtro_parte_articolo" value="" />
    <input type="hidden" id="bridge_filtro_parte_comma" name="filtro_parte_comma" value="" />
    <input type="hidden" id="bridge_filtro_parte_lettera" name="filtro_parte_lettera" value="" />
    <input type="hidden" id="bridge_filtro_parte_titolo" name="filtro_parte_titolo" value="" />
    <input type="hidden" id="bridge_filtro_parte_capo" name="filtro_parte_capo" value="" />
    <input type="hidden" id="bridge_filtro_parte_missione" name="filtro_parte_missione" value="" />
    <input type="hidden" id="bridge_filtro_parte_programma" name="filtro_parte_programma" value="" />
    <input type="hidden" id="bridge_filtro_gruppo" name="filtro_gruppo" value="" />
    <input type="hidden" id="bridge_filtro_proponente" name="filtro_proponente" value="" />
    <input type="hidden" id="bridge_filtro_firmatari" name="filtro_firmatari" value="" />
    <input type="hidden" id="bridge_filtro_my" name="filtro_my" value="" />
    <input type="hidden" id="bridge_filtro_effetti_finanziari" name="filtro_effetti_finanziari" value="" />
}


<script>
    var selectedSortColumnsEM = [];
    var chipsKeysEM = {};
    var idLegislaturaEM = "@(Model.Atto.Legislatura ?? Model.Atto.SEDUTE?.id_legislatura)";

    // Chiavi dei filtri default/fissi (non eliminabili dall'utente)
    var defaultKeysEM = new Set(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        new List<string>(new[] { nameof(EmendamentiDto.UIDAtto) }
            .Concat(Model.Mode == ClientModeEnum.GRUPPI && !load_gruppi && Model.CurrentUser?.Gruppo != null
                ? new[] { nameof(EmendamentiDto.id_gruppo) }
                : new string[0]))
    )));

    var availableFilterArrayEM = [
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.IDStato))", id: "@nameof(EmendamentiDto.IDStato)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.IDTipo_EM))", id: "@nameof(EmendamentiDto.IDTipo_EM)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.IDParte))", id: "@nameof(EmendamentiDto.IDParte)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.N_EM))", id: "@nameof(EmendamentiDto.N_EM)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.UIDPersonaProponente))", id: "@nameof(EmendamentiDto.UIDPersonaProponente)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.Firme))", id: "@nameof(EmendamentiDto.Firme)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.TestoEM_originale))", id: "@nameof(EmendamentiDto.TestoEM_originale)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.Tags))", id: "@nameof(EmendamentiDto.Tags)" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.Rif_UIDEM))", id: "@nameof(EmendamentiDto.Rif_UIDEM)" },
        { tag: "Miei emendamenti", id: "MyEM" },
        { tag: "Emendamenti da firmare", id: "EMDaFirmare" },
        { tag: "@Utility.GetDisplayName(typeof(EmendamentiDto), nameof(EmendamentiDto.EffettiFinanziari))", id: "@nameof(EmendamentiDto.EffettiFinanziari)" },
    ];

    document.addEventListener('DOMContentLoaded',
        async function () {
            var dataSource = availableFilterArrayEM;

            var elems = document.querySelectorAll('#autocomplete-input');
            var instances = M.Autocomplete.init(elems,
                {
                    data: dataSource,
                    onAutocomplete: async function (txt, key) {
                        await openModalWithContentEM(key, txt, false, 0);
                    }
                });

            if (document.getElementById('autocomplete-input')) {
                document.getElementById('autocomplete-input').addEventListener('keydown',
                    function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            var autocompleteList = document.querySelectorAll('.autocomplete-content.dropdown-content li');
                            if (autocompleteList.length > 0 && !autocompleteList[0].classList.contains('disabled')) {
                                autocompleteList[0].click();
                            }
                        }
                    });
            }

            // Init modals
            var modalElems = document.querySelectorAll('.modal');
            M.Modal.init(modalElems);

            // Ripristino filtri con merge dei default (pattern identico a DASI TRATTAZIONE)
            ripristinaFiltriEM();
            ripristinaOrdinamentoEM();

            await creaPannelloFiltriLateraleEM();
            await ripristinaPreferitiEM();

            // Report init
            await ripristinaReportsEM();

            document.getElementById('addFiltersButton').addEventListener('click',
                function () {
                    var key = document.getElementById('modal-filter-id-hidden').value;
                    var keyLabel = document.getElementById('modal-content').textContent;
                    var val, text, chipText;

                    if (key === "@nameof(EmendamentiDto.TestoEM_originale)") {
                        var text1 = document.getElementById('em_text1').value;
                        var connector = document.getElementById('em_text_connector').value;
                        var text2 = document.getElementById('em_text2').value;
                        val = text1 + "|" + connector + "|" + text2;
                        var connectorText = connector === "1" ? "AND" : "OR";
                        text = text1;
                        if (text2) {
                            text += " " + connectorText + " " + text2;
                        }
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.N_EM)") {
                        val = document.getElementById('em_n_em').value;
                        text = val;
                        chipText = keyLabel + ": " + val;
                    } else if (key === "@nameof(EmendamentiDto.Rif_UIDEM)") {
                        val = document.getElementById('em_subem').checked;
                        text = val ? 'Si' : 'No';
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.IDTipo_EM)") {
                        var selectedOptions = document.querySelectorAll('#tipi-em-select option:checked');
                        var values = Array.from(selectedOptions).map(function(o) { return o.value; });
                        var texts = Array.from(selectedOptions).map(function(o) { return o.text; });
                        val = values.join(',');
                        text = texts.join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.IDStato)") {
                        var selectedOptions = document.querySelectorAll('#stati-em-select option:checked');
                        var values = Array.from(selectedOptions).map(function(o) { return o.value; });
                        var texts = Array.from(selectedOptions).map(function(o) { return o.text; });
                        val = values.join(',');
                        text = texts.join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.IDParte)") {
                        // Parte con cascading: raccoglie parte + sotto-filtri
                        var parteSelect = document.getElementById('parti-em-select');
                        var parteVal = parteSelect.value;
                        var parteText = parteSelect.options[parteSelect.selectedIndex] ? parteSelect.options[parteSelect.selectedIndex].text : '';
                        val = parteVal;
                        text = parteText;

                        // Cascading sub-values
                        var artSelect = document.getElementById('articoli-em-select');
                        var commaSelect = document.getElementById('commi-em-select');
                        var letteraSelect = document.getElementById('lettere-em-select');
                        var missioneSelect = document.getElementById('missioni-em-select');
                        var programmaInput = document.getElementById('em_programma');
                        var titoloInput = document.getElementById('em_titolo');
                        var capoInput = document.getElementById('em_capo');

                        if (artSelect && artSelect.value) {
                            val += "|art:" + artSelect.value;
                            text += ", Art. " + (artSelect.options[artSelect.selectedIndex] ? artSelect.options[artSelect.selectedIndex].text : '');
                        }
                        if (commaSelect && commaSelect.value) {
                            val += "|com:" + commaSelect.value;
                            text += ", C. " + (commaSelect.options[commaSelect.selectedIndex] ? commaSelect.options[commaSelect.selectedIndex].text : '');
                        }
                        if (letteraSelect && letteraSelect.value) {
                            val += "|let:" + letteraSelect.value;
                            text += ", L. " + (letteraSelect.options[letteraSelect.selectedIndex] ? letteraSelect.options[letteraSelect.selectedIndex].text : '');
                        }
                        if (missioneSelect && missioneSelect.value) {
                            val += "|mis:" + missioneSelect.value;
                            text += ", Miss. " + (missioneSelect.options[missioneSelect.selectedIndex] ? missioneSelect.options[missioneSelect.selectedIndex].text : '');
                        }
                        if (programmaInput && programmaInput.value) {
                            val += "|prog:" + programmaInput.value;
                            text += ", Prog. " + programmaInput.value;
                        }
                        if (titoloInput && titoloInput.value) {
                            val += "|tit:" + titoloInput.value;
                            text += ", Tit. " + titoloInput.value;
                        }
                        if (capoInput && capoInput.value) {
                            val += "|capo:" + capoInput.value;
                            text += ", Capo " + capoInput.value;
                        }

                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.UIDPersonaProponente)") {
                        text = "";
                        val = "";
                        var existingChips = document.querySelectorAll('.chip[data-proponente-em-uid]');
                        existingChips.forEach(function (item, index) {
                            var chipInnerText = Array.from(item.childNodes)
                                .filter(function(node) { return node.nodeType === Node.TEXT_NODE; })
                                .map(function(node) { return node.textContent.trim(); })
                                .join('');
                            if (index > 0) { text += ", "; val += ","; }
                            text += chipInnerText;
                            val += item.getAttribute('data-proponente-em-uid');
                        });
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.Firme)") {
                        text = "";
                        val = "";
                        var existingChips = document.querySelectorAll('.chip[data-firmatario-em-uid]');
                        existingChips.forEach(function (item, index) {
                            var chipInnerText = Array.from(item.childNodes)
                                .filter(function(node) { return node.nodeType === Node.TEXT_NODE; })
                                .map(function(node) { return node.textContent.trim(); })
                                .join('');
                            if (index > 0) { text += ", "; val += ","; }
                            text += chipInnerText;
                            val += item.getAttribute('data-firmatario-em-uid');
                        });
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.Tags)") {
                        var tagsInstance = M.Chips.getInstance(document.querySelector('#tagsEmModal'));
                        var tagsData = tagsInstance ? tagsInstance.chipsData : [];
                        val = JSON.stringify(tagsData);
                        text = tagsData.map(function(t) { return t.tag; }).join(', ');
                        chipText = keyLabel + ": " + text;
                    } else if (key === "MyEM") {
                        val = document.getElementById('em_my').checked;
                        text = val ? 'Si' : 'No';
                        chipText = keyLabel + ": " + text;
                    } else if (key === "EMDaFirmare") {
                        val = document.getElementById('em_da_firmare').checked;
                        text = val ? 'Si' : 'No';
                        chipText = keyLabel + ": " + text;
                    } else if (key === "@nameof(EmendamentiDto.EffettiFinanziari)") {
                        val = document.getElementById('em_effetti_finanziari').checked;
                        text = val ? 'Si' : 'No';
                        chipText = keyLabel + ": " + text;
                    }

                    addChipIfNotExistsEM(key, keyLabel, val, text, chipText, true, true);
                    resetSelezionePreferitiEM();
                    $('#infoModal').modal("close");
                });
        });

    async function openModalWithContentEM(key, txt, isEditing, currentValue) {
        waiting(true);

        document.getElementById('autocomplete-input').value = "";
        document.getElementById('modal-content').textContent = txt;
        document.getElementById('modal-filter-id-hidden').value = key;
        var selectHTML = '';

        switch (key) {
            case '@nameof(EmendamentiDto.TestoEM_originale)':
                var parts = isEditing && currentValue ? currentValue.toString().split('|') : ['', '1', ''];
                selectHTML = '<div class="row valign-wrapper">' +
                    '<div class="input-field col s5">' +
                    '<input id="em_text1" type="text" value="' + (parts[0] || '') + '" placeholder="Testo da cercare">' +
                    '<label for="em_text1" class="active">Testo 1</label></div>' +
                    '<div class="input-field col s2">' +
                    '<select id="em_text_connector">' +
                    '<option value="1"' + ((parts[1] || '1') === '1' ? ' selected' : '') + '>AND</option>' +
                    '<option value="2"' + (parts[1] === '2' ? ' selected' : '') + '>OR</option>' +
                    '</select></div>' +
                    '<div class="input-field col s5">' +
                    '<input id="em_text2" type="text" value="' + (parts[2] || '') + '" placeholder="Testo da cercare">' +
                    '<label for="em_text2" class="active">Testo 2</label></div></div>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                M.FormSelect.init(document.querySelectorAll('#em_text_connector'));
                break;

            case '@nameof(EmendamentiDto.N_EM)':
                var currentVal = isEditing && currentValue ? 'value="' + currentValue + '"' : '';
                selectHTML = '<div class="input-field col s12">' +
                    '<input id="em_n_em" type="text" ' + currentVal + ' placeholder="Es. 100, 150-200">' +
                    '<div class="card blue lighten-5"><div class="card-content black-text">' +
                    '<span class="card-title">Informazioni</span>' +
                    '<p>Filtrare per:<ul style="padding-left:40px">' +
                    '<li style="list-style-type:disc">Singolo numero: 100</li>' +
                    '<li style="list-style-type:disc">Intervallo: 150-200</li>' +
                    '</ul></p></div></div></div>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                break;

            case '@nameof(EmendamentiDto.Rif_UIDEM)':
                var checked = isEditing && currentValue === true ? 'checked' : '';
                selectHTML = '<p><label><input id="em_subem" type="checkbox" ' + checked + '/>' +
                    '<span>Cerca solo Sub-Emendamenti</span></label></p>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                break;

            case '@nameof(EmendamentiDto.IDTipo_EM)':
                var currentTipi = isEditing && currentValue ? currentValue.toString().split(',') : [];
                selectHTML = '<select id="tipi-em-select" multiple>' +
                    '<option value="@((int)TipiEMEnum.SOPPRESSIVO)"' + (currentTipi.indexOf('@((int)TipiEMEnum.SOPPRESSIVO)') !== -1 ? ' selected' : '') + '>Soppressivo</option>' +
                    '<option value="@((int)TipiEMEnum.MODIFICATIVO)"' + (currentTipi.indexOf('@((int)TipiEMEnum.MODIFICATIVO)') !== -1 ? ' selected' : '') + '>Modificativo</option>' +
                    '<option value="@((int)TipiEMEnum.AGGIUNTIVO)"' + (currentTipi.indexOf('@((int)TipiEMEnum.AGGIUNTIVO)') !== -1 ? ' selected' : '') + '>Aggiuntivo</option>' +
                    '<option value="@((int)TipiEMEnum.SOSTITUTIVO)"' + (currentTipi.indexOf('@((int)TipiEMEnum.SOSTITUTIVO)') !== -1 ? ' selected' : '') + '>Sostitutivo</option>' +
                    '</select>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                M.FormSelect.init(document.querySelectorAll('#tipi-em-select'));
                break;

            case '@nameof(EmendamentiDto.IDStato)':
                var currentStati = isEditing && currentValue ? currentValue.toString().split(',') : [];
                selectHTML = '<select id="stati-em-select" multiple>' +
                    '<option value="@((int)StatiEnum.Bozza_Riservata)"' + (currentStati.indexOf('@((int)StatiEnum.Bozza_Riservata)') !== -1 ? ' selected' : '') + '>Bozza Riservata</option>' +
                    '<option value="@((int)StatiEnum.Bozza)"' + (currentStati.indexOf('@((int)StatiEnum.Bozza)') !== -1 ? ' selected' : '') + '>Bozza</option>' +
                    '<option value="@((int)StatiEnum.Depositato)"' + (currentStati.indexOf('@((int)StatiEnum.Depositato)') !== -1 ? ' selected' : '') + '>Depositato</option>' +
                    '<option value="@((int)StatiEnum.Approvato)"' + (currentStati.indexOf('@((int)StatiEnum.Approvato)') !== -1 ? ' selected' : '') + '>Approvato</option>' +
                    '<option value="@((int)StatiEnum.Non_Approvato)"' + (currentStati.indexOf('@((int)StatiEnum.Non_Approvato)') !== -1 ? ' selected' : '') + '>Non Approvato</option>' +
                    '<option value="@((int)StatiEnum.Ritirato)"' + (currentStati.indexOf('@((int)StatiEnum.Ritirato)') !== -1 ? ' selected' : '') + '>Ritirato</option>' +
                    '<option value="@((int)StatiEnum.Decaduto)"' + (currentStati.indexOf('@((int)StatiEnum.Decaduto)') !== -1 ? ' selected' : '') + '>Decaduto</option>' +
                    '<option value="@((int)StatiEnum.Inammissibile)"' + (currentStati.indexOf('@((int)StatiEnum.Inammissibile)') !== -1 ? ' selected' : '') + '>Inammissibile</option>' +
                    '<option value="@((int)StatiEnum.Approvato_Con_Modifiche)"' + (currentStati.indexOf('@((int)StatiEnum.Approvato_Con_Modifiche)') !== -1 ? ' selected' : '') + '>Approvato con modifiche</option>' +
                    '</select>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                M.FormSelect.init(document.querySelectorAll('#stati-em-select'));
                break;

            case '@nameof(EmendamentiDto.IDParte)':
                // Parte con cascading interno - parse currentValue composto (es. "4|art:guid|com:guid")
                var parteparts = isEditing && currentValue ? currentValue.toString().split('|') : [];
                var parteCurrentVal = parteparts.length > 0 ? parteparts[0] : '';

                selectHTML = '<div id="parte-cascading-container">' +
                    '<div class="input-field col s12"><label class="active">Parte</label>' +
                    '<select id="parti-em-select" onchange="onParteChangeEM(this.value)">' +
                    '<option value="" disabled' + (parteCurrentVal === '' ? ' selected' : '') + '>Seleziona</option>' +
                    '<option value="@((int)PartiEMEnum.Titolo_PDL)"' + (parteCurrentVal === '@((int)PartiEMEnum.Titolo_PDL)' ? ' selected' : '') + '>Titolo PDL</option>' +
                    '<option value="@((int)PartiEMEnum.Titolo)"' + (parteCurrentVal === '@((int)PartiEMEnum.Titolo)' ? ' selected' : '') + '>Titolo</option>' +
                    '<option value="@((int)PartiEMEnum.Capo)"' + (parteCurrentVal === '@((int)PartiEMEnum.Capo)' ? ' selected' : '') + '>Capo</option>' +
                    '<option value="@((int)PartiEMEnum.Articolo)"' + (parteCurrentVal === '@((int)PartiEMEnum.Articolo)' ? ' selected' : '') + '>Articolo</option>' +
                    '<option value="@((int)PartiEMEnum.Missione)"' + (parteCurrentVal === '@((int)PartiEMEnum.Missione)' ? ' selected' : '') + '>Missione</option>' +
                    '<option value="@((int)PartiEMEnum.Allegato_Tabella)"' + (parteCurrentVal === '@((int)PartiEMEnum.Allegato_Tabella)' ? ' selected' : '') + '>Allegato/Tabella</option>' +
                    '</select></div>' +
                    '<div id="parte-sub-filters"></div></div>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                M.FormSelect.init(document.querySelectorAll('#parti-em-select'));

                // Se in modifica, triggera il cascading con i sotto-valori
                if (isEditing && parteCurrentVal !== '') {
                    // Carica sotto-filtri della parte
                    await onParteChangeEM(parteCurrentVal);

                    // Estrai sotto-valori dal composto
                    var subVals = {};
                    parteparts.forEach(function(p) {
                        var idx = p.indexOf(':');
                        if (idx > 0) subVals[p.substring(0, idx)] = p.substring(idx + 1);
                    });

                    // Cascading sequenziale: articolo -> commi -> lettere
                    if (subVals['art']) {
                        var artSelect = document.getElementById('articoli-em-select');
                        if (artSelect) {
                            artSelect.value = subVals['art'];
                            M.FormSelect.init(document.querySelectorAll('#articoli-em-select'));
                            // Carica commi per l'articolo selezionato
                            await onArticoloChangeEM(subVals['art']);
                            if (subVals['com']) {
                                var comSelect = document.getElementById('commi-em-select');
                                if (comSelect) {
                                    comSelect.value = subVals['com'];
                                    M.FormSelect.init(document.querySelectorAll('#commi-em-select'));
                                    // Carica lettere per il comma selezionato
                                    await onCommaChangeEM(subVals['com']);
                                    if (subVals['let']) {
                                        var letSelect = document.getElementById('lettere-em-select');
                                        if (letSelect) {
                                            letSelect.value = subVals['let'];
                                            M.FormSelect.init(document.querySelectorAll('#lettere-em-select'));
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (subVals['mis']) {
                        var misSelect = document.getElementById('missioni-em-select');
                        if (misSelect) { misSelect.value = subVals['mis']; M.FormSelect.init(document.querySelectorAll('#missioni-em-select')); }
                    }
                    if (subVals['prog']) {
                        var progInput = document.getElementById('em_programma');
                        if (progInput) progInput.value = subVals['prog'];
                    }
                    if (subVals['tit']) {
                        var titInput = document.getElementById('em_titolo');
                        if (titInput) titInput.value = subVals['tit'];
                    }
                    if (subVals['capo']) {
                        var capoInput = document.getElementById('em_capo');
                        if (capoInput) capoInput.value = subVals['capo'];
                    }
                }
                break;

            case '@nameof(EmendamentiDto.UIDPersonaProponente)':
                var persone = await GetProponenti(idLegislaturaEM);
                selectHTML = '<div id="modal-proponenti-container">' +
                    '<div class="input-field col s12"><input id="proponenti-em-search" type="text" placeholder="Cerca persona..."><label for="proponenti-em-search" class="active">Cerca</label></div>' +
                    '<div id="proponenti-em-chips"></div>' +
                    '<div id="proponenti-em-list" class="collection" style="max-height:300px;overflow-y:auto">';
                if (persone && persone.length) {
                    persone.forEach(function (item) {
                        selectHTML += '<a class="collection-item proponente-em-item" data-uid="' + item.UID_persona + '" href="#">' + item.DisplayName + '</a>';
                    });
                }
                selectHTML += '</div></div>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                setupMultiPickerEM('proponente-em', 'proponenti-em', 'data-proponente-em-uid');
                break;

            case '@nameof(EmendamentiDto.Firme)':
                var persone = await GetProponenti(idLegislaturaEM);
                selectHTML = '<div id="modal-firmatari-container">' +
                    '<div class="input-field col s12"><input id="firmatari-em-search" type="text" placeholder="Cerca persona..."><label for="firmatari-em-search" class="active">Cerca</label></div>' +
                    '<div id="firmatari-em-chips"></div>' +
                    '<div id="firmatari-em-list" class="collection" style="max-height:300px;overflow-y:auto">';
                if (persone && persone.length) {
                    persone.forEach(function (item) {
                        selectHTML += '<a class="collection-item firmatario-em-item" data-uid="' + item.UID_persona + '" href="#">' + item.DisplayName + '</a>';
                    });
                }
                selectHTML += '</div></div>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                setupMultiPickerEM('firmatario-em', 'firmatari-em', 'data-firmatario-em-uid');
                break;

            case '@nameof(EmendamentiDto.Tags)':
                var tagsInDb = await GetTags();
                selectHTML = '<div class="chips" id="tagsEmModal"></div>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                var currentTags = [];
                if (isEditing && currentValue) {
                    try { currentTags = JSON.parse(currentValue); } catch (e) { }
                }
                M.Chips.init(document.querySelectorAll('#tagsEmModal'), {
                    data: currentTags,
                    placeholder: 'Aggiungi un tag',
                    secondaryPlaceholder: '+ Tag',
                    autocompleteOptions: { data: tagsInDb, limit: Infinity, minLength: 1 }
                });
                break;

            case 'MyEM':
                var checked = isEditing && currentValue === true ? 'checked' : '';
                selectHTML = '<p><label><input id="em_my" type="checkbox" ' + checked + '/>' +
                    '<span>Visualizza i miei EM</span></label></p>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                break;

            case 'EMDaFirmare':
                var checked = isEditing && currentValue === true ? 'checked' : '';
                selectHTML = '<p><label><input id="em_da_firmare" type="checkbox" ' + checked + '/>' +
                    '<span>Mostra solo emendamenti per cui \u00E8 richiesta la mia firma</span></label></p>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                break;

            case '@nameof(EmendamentiDto.EffettiFinanziari)':
                var checked = isEditing && currentValue === true ? 'checked' : '';
                selectHTML = '<p><label><input id="em_effetti_finanziari" type="checkbox" ' + checked + '/>' +
                    '<span>Visualizza solo EM con effetti finanziari</span></label></p>';
                document.getElementById('dynamic-select-container').innerHTML = selectHTML;
                break;
        }

        waiting(false);
        $('#infoModal').modal("open");
    }

